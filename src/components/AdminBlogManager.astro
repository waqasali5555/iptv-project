<section class="admin-cms-panel w-full min-w-0" aria-labelledby="admin-blog-heading">
  <div class="grid min-w-0 gap-6 xl:grid-cols-[1.15fr_0.85fr]">
    <form id="admin-blog-form" class="surface grid w-full min-w-0 gap-4 p-5 md:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border pb-4">
        <div>
          <p class="eyebrow">Blog CMS</p>
          <h2 id="admin-blog-heading" class="mt-1.5 text-xl font-bold text-foreground">
            Create / Edit Blog Post
          </h2>
        </div>
        <button type="button" id="blog-reset-btn" class="btn btn-secondary min-h-9 cursor-pointer px-3 text-xs">
          New Post
        </button>
      </div>

      <input type="hidden" id="blog-id" name="id" />

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
          Title
          <input
            id="blog-title"
            name="title"
            type="text"
            required
            placeholder="How to Fix IPTV Buffering & Stream Freezing"
            class="rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
          />
        </label>

        <label class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
          Slug
          <input
            id="blog-slug"
            name="slug"
            type="text"
            required
            placeholder="how-to-fix-iptv-buffering-and-stream-freezing"
            class="rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
          />
        </label>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
          Category
          <select
            id="blog-category"
            name="category"
            class="rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
          >
            <option value="IPTV & OTT">IPTV &amp; OTT</option>
            <option value="Plex & Unraid">Plex &amp; Unraid</option>
            <option value="NAS & DevOps">NAS &amp; DevOps</option>
          </select>
        </label>

        <div class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
          <span>Cover Image (plextech-media)</span>
          <div class="flex items-center gap-2">
            <input
              id="blog-cover-url"
              name="cover_image_url"
              type="url"
              placeholder="https://.../cover.png"
              class="min-w-0 flex-1 rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
            />
            <label class="btn btn-secondary min-h-10 shrink-0 cursor-pointer px-3 text-xs">
              Upload
              <input id="blog-cover-file" type="file" accept="image/*" class="sr-only" />
            </label>
          </div>
        </div>
      </div>

      <div id="blog-cover-preview-wrap" class="hidden overflow-hidden rounded-xl border border-border bg-background p-2">
        <img id="blog-cover-preview" src="" alt="Cover preview" class="max-h-40 w-full rounded-lg object-cover" />
      </div>

      <label class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
        Excerpt
        <textarea
          id="blog-excerpt"
          name="excerpt"
          rows="2"
          required
          placeholder="Concise summary shown on /blog and social cards…"
          class="rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
        ></textarea>
      </label>

      <div class="grid gap-1.5">
        <div class="flex items-center justify-between gap-2">
          <label for="blog-content" class="text-xs font-semibold tracking-wide text-foreground uppercase">
            Content (Markdown)
          </label>
          <button
            type="button"
            id="blog-preview-toggle"
            class="cursor-pointer rounded-md border border-border bg-background px-2.5 py-1 text-xs font-semibold text-primary hover:border-primary"
          >
            Preview Markdown
          </button>
        </div>
        <textarea
          id="blog-content"
          name="content"
          rows="10"
          required
          placeholder="## Heading&#10;&#10;Write Markdown guide content here…"
          class="rounded-lg border border-border bg-background px-3 py-2.5 font-mono text-xs leading-relaxed text-foreground"
        ></textarea>
        <div
          id="blog-markdown-preview"
          data-live-prose
          hidden
          class="prose max-h-96 overflow-y-auto rounded-lg border border-border bg-background p-4 text-sm"
        ></div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
          SEO Meta Title
          <input
            id="blog-meta-title"
            name="meta_title"
            type="text"
            placeholder="Custom title for search results"
            class="rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
          />
        </label>

        <label class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
          SEO Meta Description
          <input
            id="blog-meta-description"
            name="meta_description"
            type="text"
            placeholder="140–160 char meta description"
            class="rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
          />
        </label>
      </div>

      <label class="inline-flex w-max cursor-pointer items-center gap-2.5 text-sm font-semibold text-foreground">
        <input id="blog-published" name="published" type="checkbox" class="size-4 accent-primary" />
        <span>Published (visible publicly on /blog and sitemap.xml)</span>
      </label>

      <p id="admin-blog-status" class="min-h-5 text-xs text-muted" aria-live="polite"></p>

      <div class="flex flex-wrap gap-3">
        <button type="submit" id="blog-save-btn" class="btn btn-primary cursor-pointer">
          Save Blog Post
        </button>
      </div>
    </form>

    <aside class="surface flex w-full min-w-0 flex-col overflow-hidden">
      <div class="flex items-center justify-between gap-3 border-b border-border px-5 py-4">
        <div class="min-w-0">
          <h3 class="text-base font-bold text-foreground">All Blog Posts</h3>
          <p class="text-xs text-muted">Published and draft articles</p>
        </div>
        <span
          id="admin-blog-count"
          class="inline-grid min-h-7 min-w-7 shrink-0 place-items-center rounded-full bg-cyan-500/15 px-2 text-xs font-bold text-cyan-300"
        >
          0
        </span>
      </div>

      <div id="admin-blog-seed-wrap" class="hidden border-b border-border bg-primary/5 p-4">
        <p class="text-xs text-muted">No blog posts in Supabase yet.</p>
        <button type="button" id="blog-seed-btn" class="btn btn-secondary mt-2 min-h-9 cursor-pointer px-3 text-xs">
          Seed Starter Blog Post
        </button>
      </div>

      <div id="admin-blog-list" class="flex max-h-[44rem] w-full min-w-0 flex-col gap-3 overflow-y-auto p-4">
        <p class="text-sm text-muted">Sign in to manage blog posts.</p>
      </div>
    </aside>
  </div>
</section>

<script>
  import { supabase } from '../lib/supabase';
  import { formatDisplayDate, MEDIA_BUCKET, SEED_BLOG_POSTS, slugify, type BlogPost, type CmsCategory } from '../lib/cms';
  import { renderMarkdown } from '../lib/markdown';

  const form = document.getElementById('admin-blog-form') as HTMLFormElement | null;
  const idInput = document.getElementById('blog-id') as HTMLInputElement | null;
  const titleInput = document.getElementById('blog-title') as HTMLInputElement | null;
  const slugInput = document.getElementById('blog-slug') as HTMLInputElement | null;
  const categorySelect = document.getElementById('blog-category') as HTMLSelectElement | null;
  const coverUrlInput = document.getElementById('blog-cover-url') as HTMLInputElement | null;
  const coverFileInput = document.getElementById('blog-cover-file') as HTMLInputElement | null;
  const coverPreviewWrap = document.getElementById('blog-cover-preview-wrap');
  const coverPreviewImg = document.getElementById('blog-cover-preview') as HTMLImageElement | null;
  const excerptInput = document.getElementById('blog-excerpt') as HTMLTextAreaElement | null;
  const contentInput = document.getElementById('blog-content') as HTMLTextAreaElement | null;
  const previewToggle = document.getElementById('blog-preview-toggle') as HTMLButtonElement | null;
  const previewBox = document.getElementById('blog-markdown-preview');
  const metaTitleInput = document.getElementById('blog-meta-title') as HTMLInputElement | null;
  const metaDescInput = document.getElementById('blog-meta-description') as HTMLInputElement | null;
  const publishedInput = document.getElementById('blog-published') as HTMLInputElement | null;
  const resetBtn = document.getElementById('blog-reset-btn');
  const saveBtn = document.getElementById('blog-save-btn') as HTMLButtonElement | null;
  const statusEl = document.getElementById('admin-blog-status');
  const listEl = document.getElementById('admin-blog-list');
  const countEl = document.getElementById('admin-blog-count');
  const seedWrap = document.getElementById('admin-blog-seed-wrap');
  const seedBtn = document.getElementById('blog-seed-btn') as HTMLButtonElement | null;

  let posts: BlogPost[] = [];
  let slugManuallyEdited = false;

  const setStatus = (msg: string, isError = false) => {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.className = `min-h-5 text-xs ${isError ? 'text-red-300' : 'text-muted'}`;
  };

  const updateCoverPreview = (url: string) => {
    if (!coverPreviewWrap || !coverPreviewImg) return;
    if (url.trim()) {
      coverPreviewImg.src = url.trim();
      coverPreviewWrap.classList.remove('hidden');
    } else {
      coverPreviewImg.src = '';
      coverPreviewWrap.classList.add('hidden');
    }
  };

  const resetForm = () => {
    form?.reset();
    if (idInput) idInput.value = '';
    slugManuallyEdited = false;
    updateCoverPreview('');
    if (previewBox && contentInput && previewToggle) {
      previewBox.hidden = true;
      contentInput.hidden = false;
      previewToggle.textContent = 'Preview Markdown';
    }
    setStatus('');
  };

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch] || ch);

  const renderPostsList = () => {
    if (!listEl || !countEl) return;
    countEl.textContent = String(posts.length);
    if (seedWrap) seedWrap.classList.toggle('hidden', posts.length > 0);

    if (!posts.length) {
      listEl.innerHTML = '<p class="text-sm text-slate-300">No blog posts found.</p>';
      return;
    }

    listEl.innerHTML = posts
      .map(
        (post) => `
      <article class="w-full min-w-0 bg-slate-900/80 border border-slate-800 text-slate-100 rounded-xl p-4 flex flex-col gap-3" data-post-id="${escapeHtml(post.id)}">
        <div class="flex items-start justify-between gap-3 min-w-0">
          <div class="min-w-0 flex-1">
            <h4 class="text-sm font-bold text-slate-100 break-words">${escapeHtml(post.title)}</h4>
            <p class="mt-1 text-xs text-slate-400 break-all">${escapeHtml(post.category)} • /blog/${escapeHtml(post.slug)}/</p>
          </div>
          <span class="shrink-0 inline-flex items-center rounded-full px-2.5 py-1 text-[0.7rem] font-bold ${
            post.published
              ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40'
              : 'bg-slate-800 text-slate-300 border border-slate-700'
          }">
            ${post.published ? 'Published' : 'Draft'}
          </span>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-800/80 pt-3">
          <span class="text-[0.7rem] text-slate-400">Updated ${escapeHtml(formatDisplayDate(post.updated_at || post.created_at))}</span>
          <div class="flex flex-wrap gap-1.5">
            <button type="button" data-blog-action="edit" data-id="${escapeHtml(post.id)}" class="cursor-pointer rounded-md border border-slate-700 bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-100 hover:border-cyan-400">Edit</button>
            <button type="button" data-blog-action="toggle" data-id="${escapeHtml(post.id)}" class="cursor-pointer rounded-md border border-cyan-500/40 bg-cyan-500/15 px-2.5 py-1 text-xs font-semibold text-cyan-300 hover:bg-cyan-500/25">${post.published ? 'Unpublish' : 'Publish'}</button>
            <a href="/blog/post/?slug=${encodeURIComponent(post.slug)}" target="_blank" rel="noopener noreferrer" class="rounded-md border border-slate-700 bg-slate-800/60 px-2.5 py-1 text-xs font-semibold text-slate-200 hover:border-cyan-400 hover:text-white">View</a>
            <button type="button" data-blog-action="delete" data-id="${escapeHtml(post.id)}" class="cursor-pointer rounded-md border border-red-500/40 bg-red-500/15 px-2.5 py-1 text-xs font-semibold text-red-300 hover:bg-red-500/25">Delete</button>
          </div>
        </div>
      </article>
    `,
      )
      .join('');
  };

  const loadPosts = async () => {
    setStatus('Loading blog posts…');
    const { data, error } = await supabase
      .from('blog_posts')
      .select('*')
      .order('created_at', { ascending: false });

    if (error) {
      setStatus(`Could not load blog posts (${error.code ?? 'error'}: ${error.message}).`, true);
      return;
    }

    posts = (data ?? []) as BlogPost[];
    renderPostsList();
    setStatus('');
  };

  titleInput?.addEventListener('input', () => {
    if (!slugManuallyEdited && slugInput && !idInput?.value) {
      slugInput.value = slugify(titleInput.value);
    }
  });

  slugInput?.addEventListener('input', () => {
    slugManuallyEdited = true;
  });

  coverUrlInput?.addEventListener('input', () => {
    updateCoverPreview(coverUrlInput.value);
  });

  coverFileInput?.addEventListener('change', async () => {
    const file = coverFileInput.files?.[0];
    if (!file) return;
    setStatus('Uploading cover image to plextech-media…');
    const safeName = `${Date.now()}-${file.name.replace(/[^a-zA-Z0-9._-]+/g, '-')}`;
    const filePath = `blog/${safeName}`;

    const { error } = await supabase.storage.from(MEDIA_BUCKET).upload(filePath, file, {
      cacheControl: '3600',
      upsert: false,
    });

    if (error) {
      setStatus(`Image upload failed: ${error.message}`, true);
      return;
    }

    const { data } = supabase.storage.from(MEDIA_BUCKET).getPublicUrl(filePath);
    if (coverUrlInput) coverUrlInput.value = data.publicUrl;
    updateCoverPreview(data.publicUrl);
    setStatus('Cover image uploaded.');
    coverFileInput.value = '';
  });

  previewToggle?.addEventListener('click', () => {
    if (!previewBox || !contentInput) return;
    const showingPreview = !previewBox.hidden;
    if (showingPreview) {
      previewBox.hidden = true;
      contentInput.hidden = false;
      previewToggle.textContent = 'Preview Markdown';
    } else {
      previewBox.innerHTML = renderMarkdown(contentInput.value);
      previewBox.hidden = false;
      contentInput.hidden = true;
      previewToggle.textContent = 'Edit Markdown';
    }
  });

  resetBtn?.addEventListener('click', resetForm);

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!titleInput || !slugInput || !categorySelect || !excerptInput || !contentInput || !saveBtn) return;

    saveBtn.disabled = true;
    setStatus('Saving blog post…');

    const payload = {
      title: titleInput.value.trim(),
      slug: slugify(slugInput.value || titleInput.value),
      category: categorySelect.value as CmsCategory,
      cover_image_url: coverUrlInput?.value.trim() || null,
      excerpt: excerptInput.value.trim(),
      content: contentInput.value,
      meta_title: metaTitleInput?.value.trim() || `${titleInput.value.trim()} | PlexTech`,
      meta_description: metaDescInput?.value.trim() || excerptInput.value.trim(),
      published: Boolean(publishedInput?.checked),
    };

    const existingId = idInput?.value.trim();
    const result = existingId
      ? await supabase.from('blog_posts').update(payload).eq('id', existingId)
      : await supabase.from('blog_posts').insert(payload);

    if (result.error) {
      setStatus(`Save failed: ${result.error.message}`, true);
      saveBtn.disabled = false;
      return;
    }

    await loadPosts();
    resetForm();
    setStatus(existingId ? 'Blog post updated.' : 'Blog post created.');
    saveBtn.disabled = false;
  });

  listEl?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-blog-action]');
    const id = button?.dataset.id;
    const action = button?.dataset.blogAction;
    if (!id || !action) return;

    const post = posts.find((item) => item.id === id);
    if (!post) return;

    if (action === 'edit') {
      if (idInput) idInput.value = post.id;
      if (titleInput) titleInput.value = post.title;
      if (slugInput) slugInput.value = post.slug;
      slugManuallyEdited = true;
      if (categorySelect) categorySelect.value = post.category;
      if (coverUrlInput) coverUrlInput.value = post.cover_image_url || '';
      updateCoverPreview(post.cover_image_url || '');
      if (excerptInput) excerptInput.value = post.excerpt;
      if (contentInput) contentInput.value = post.content;
      if (metaTitleInput) metaTitleInput.value = post.meta_title;
      if (metaDescInput) metaDescInput.value = post.meta_description;
      if (publishedInput) publishedInput.checked = post.published;
      setStatus(`Editing "${post.title}"`);
      titleInput?.focus();
      return;
    }

    if (action === 'toggle') {
      const { error } = await supabase
        .from('blog_posts')
        .update({ published: !post.published })
        .eq('id', post.id);
      if (error) {
        setStatus(`Status update failed: ${error.message}`, true);
        return;
      }
      await loadPosts();
      setStatus(`Post marked as ${!post.published ? 'Published' : 'Draft'}.`);
      return;
    }

    if (action === 'delete') {
      if (!window.confirm(`Delete "${post.title}"? This cannot be undone.`)) return;
      const { error } = await supabase.from('blog_posts').delete().eq('id', post.id);
      if (error) {
        setStatus(`Delete failed: ${error.message}`, true);
        return;
      }
      if (idInput?.value === post.id) resetForm();
      await loadPosts();
      setStatus('Blog post deleted.');
    }
  });

  seedBtn?.addEventListener('click', async () => {
    const seed = SEED_BLOG_POSTS[0];
    if (!seed || !seedBtn) return;
    seedBtn.disabled = true;
    setStatus('Seeding starter blog post…');
    const { error } = await supabase.from('blog_posts').insert({
      title: seed.title,
      slug: seed.slug,
      excerpt: seed.excerpt,
      content: seed.content,
      category: seed.category,
      cover_image_url: seed.cover_image_url,
      meta_title: seed.meta_title,
      meta_description: seed.meta_description,
      published: seed.published,
    });
    if (error) {
      setStatus(`Seed failed: ${error.message}`, true);
    } else {
      await loadPosts();
      setStatus('Starter blog post seeded.');
    }
    seedBtn.disabled = false;
  });

  window.addEventListener('plextech:admin-auth', (event) => {
    const detail = (event as CustomEvent<{ authenticated?: boolean }>).detail;
    if (detail?.authenticated) {
      void loadPosts();
    } else {
      posts = [];
      renderPostsList();
      resetForm();
    }
  });
</script>
