<section class="admin-chat shell section" aria-labelledby="admin-chat-title">
  <div class="admin-chat__heading">
    <p class="eyebrow">Private workspace</p>
    <h1 id="admin-chat-title" class="section-title">Customer chat inbox</h1>
    <p class="lede">Review support conversations and reply securely from this device.</p>
  </div>

  <section class="admin-login surface" aria-labelledby="admin-login-title">
    <h2 id="admin-login-title">Admin sign in</h2>
    <p>Use the email and password for your authorised Supabase admin account.</p>
    <form class="admin-login__form">
      <label>
        <span>Email address</span>
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label>
        <span>Password</span>
        <input name="password" type="password" autocomplete="current-password" required />
      </label>
      <p class="admin-login__status" aria-live="polite"></p>
      <button class="btn btn-primary" type="submit">Sign in</button>
      <button class="admin-forgot-password" type="button">Forgot password?</button>
    </form>
  </section>

  <section class="admin-inbox" hidden aria-label="Customer chat inbox">
    <header class="admin-inbox__bar surface">
      <div>
        <p class="eyebrow">Authenticated session</p>
        <p class="admin-inbox__identity">Authorised administrator</p>
      </div>
      <button class="btn btn-secondary admin-signout" type="button">Sign out</button>
    </header>
    <p class="admin-inbox__status" aria-live="polite"></p>

    <div class="admin-inbox__layout">
      <aside class="admin-conversations surface" aria-label="Conversations">
        <div class="admin-panel-title">
          <h2>Conversations</h2>
          <span class="admin-conversation-count">0</span>
        </div>
        <div class="admin-conversation-list" aria-live="polite"></div>
      </aside>

      <section class="admin-thread surface" aria-labelledby="admin-thread-title">
        <header class="admin-thread__header">
          <div>
            <p class="eyebrow">Support thread</p>
            <h2 id="admin-thread-title">Choose a conversation</h2>
          </div>
          <span class="admin-thread__status" hidden></span>
        </header>
        <div class="admin-thread__messages" aria-live="polite">
          <p class="admin-empty">Select a customer conversation to read its messages.</p>
        </div>
        <form class="admin-reply-form" hidden>
          <label class="sr-only" for="admin-reply">Reply to customer</label>
          <textarea id="admin-reply" name="reply" rows="3" maxlength="4000" placeholder="Write a technical support reply…" required></textarea>
          <button class="btn btn-primary" type="submit">Send reply <span aria-hidden="true">↗</span></button>
        </form>
      </section>
    </div>
  </section>
</section>

<script>
  import { supabase } from '../lib/supabase';

  const ADMIN_USER_ID = 'e4530c3c-0a73-4569-84e1-791a9b5b1160';
  type Sender = 'visitor' | 'agent' | 'system';
  type ChatMessage = { id: string; conversation_id: string; sender: Sender; body: string; created_at: string };
  type Conversation = { id: string; visitor_id: string; status: 'open' | 'closed'; created_at: string; last_message_at: string | null };

  const root = document.querySelector<HTMLElement>('.admin-chat');
  const login = root?.querySelector<HTMLElement>('.admin-login');
  const loginForm = root?.querySelector<HTMLFormElement>('.admin-login__form');
  const loginStatus = root?.querySelector<HTMLElement>('.admin-login__status');
  const forgotPassword = root?.querySelector<HTMLButtonElement>('.admin-forgot-password');
  const inbox = root?.querySelector<HTMLElement>('.admin-inbox');
  const inboxStatus = root?.querySelector<HTMLElement>('.admin-inbox__status');
  const signOut = root?.querySelector<HTMLButtonElement>('.admin-signout');
  const list = root?.querySelector<HTMLElement>('.admin-conversation-list');
  const count = root?.querySelector<HTMLElement>('.admin-conversation-count');
  const threadTitle = root?.querySelector<HTMLElement>('#admin-thread-title');
  const threadStatus = root?.querySelector<HTMLElement>('.admin-thread__status');
  const messagesElement = root?.querySelector<HTMLElement>('.admin-thread__messages');
  const replyForm = root?.querySelector<HTMLFormElement>('.admin-reply-form');
  const replyInput = root?.querySelector<HTMLTextAreaElement>('#admin-reply');

  let conversations: Conversation[] = [];
  let previews = new Map<string, ChatMessage>();
  let selectedConversationId: string | null = null;
  let channel: ReturnType<typeof supabase.channel> | null = null;

  const reportError = (operation: string, error: { code?: string; status?: number; message?: string } | null) => {
    const detail = { operation, code: error?.code ?? 'unknown', status: error?.status ?? 0, message: error?.message ?? 'Request failed' };
    console.error('[Admin chat]', detail);
    return detail;
  };

  const setLoginStatus = (message = '', error = false) => {
    if (!loginStatus) return;
    loginStatus.textContent = message;
    loginStatus.classList.toggle('is-error', error);
  };

  const setInboxStatus = (message = '', error = false) => {
    if (!inboxStatus) return;
    inboxStatus.textContent = message;
    inboxStatus.classList.toggle('is-error', error);
  };

  const formatTime = (value: string | null) => {
    if (!value) return 'No messages yet';
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? 'Unknown time' : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(date);
  };

  const clearElement = (element: HTMLElement | undefined) => {
    if (element) element.replaceChildren();
  };

  const renderConversationList = () => {
    if (!list || !count) return;
    clearElement(list);
    count.textContent = String(conversations.length);
    if (!conversations.length) {
      const empty = document.createElement('p');
      empty.className = 'admin-empty';
      empty.textContent = 'No customer conversations yet.';
      list.append(empty);
      return;
    }
    conversations.forEach((conversation) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'admin-conversation';
      button.classList.toggle('is-active', conversation.id === selectedConversationId);
      button.dataset.conversationId = conversation.id;
      button.setAttribute('aria-pressed', String(conversation.id === selectedConversationId));

      const top = document.createElement('span');
      top.className = 'admin-conversation__top';
      const label = document.createElement('strong');
      label.textContent = `Visitor ${conversation.visitor_id.slice(0, 8)}`;
      const status = document.createElement('span');
      status.className = `admin-status admin-status--${conversation.status}`;
      status.textContent = conversation.status;
      top.append(label, status);
      const preview = document.createElement('span');
      preview.className = 'admin-conversation__preview';
      preview.textContent = previews.get(conversation.id)?.body ?? 'No customer message yet';
      const time = document.createElement('time');
      time.className = 'admin-conversation__time';
      time.dateTime = conversation.last_message_at ?? conversation.created_at;
      time.textContent = formatTime(conversation.last_message_at ?? conversation.created_at);
      button.append(top, preview, time);
      list.append(button);
    });
  };

  const renderMessages = (messages: ChatMessage[]) => {
    if (!messagesElement) return;
    clearElement(messagesElement);
    if (!messages.length) {
      const empty = document.createElement('p');
      empty.className = 'admin-empty';
      empty.textContent = 'There are no messages in this conversation.';
      messagesElement.append(empty);
      return;
    }
    messages.forEach((message) => {
      const item = document.createElement('article');
      item.className = `admin-message admin-message--${message.sender}`;
      item.dataset.messageId = message.id;
      const meta = document.createElement('div');
      meta.className = 'admin-message__meta';
      const sender = document.createElement('strong');
      sender.textContent = message.sender === 'agent' ? 'You' : message.sender === 'visitor' ? 'Visitor' : 'System';
      const time = document.createElement('time');
      time.dateTime = message.created_at;
      time.textContent = formatTime(message.created_at);
      const body = document.createElement('p');
      body.textContent = message.body;
      meta.append(sender, time);
      item.append(meta, body);
      messagesElement.append(item);
    });
    messagesElement.scrollTop = messagesElement.scrollHeight;
  };

  const getMessagePreviews = async () => {
    const { data, error } = await supabase
      .from('messages')
      .select('id, conversation_id, sender, body, created_at')
      .order('created_at', { ascending: false });
    if (error) throw { operation: 'messages_select', error };
    previews = new Map<string, ChatMessage>();
    for (const message of (data ?? []) as ChatMessage[]) {
      if (!previews.has(message.conversation_id)) previews.set(message.conversation_id, message);
    }
  };

  const loadConversations = async () => {
    setInboxStatus('Loading conversations…');
    const { data, error } = await supabase
      .from('conversations')
      .select('id, visitor_id, status, created_at, last_message_at')
      .order('last_message_at', { ascending: false });
    if (error) {
      const detail = reportError('conversation_select', error);
      setInboxStatus(`Conversations could not be loaded (${detail.code}, HTTP ${detail.status}).`, true);
      return false;
    }
    conversations = (data ?? []) as Conversation[];
    try {
      await getMessagePreviews();
    } catch (cause) {
      const issue = cause as { operation: string; error: { code?: string; status?: number; message?: string } };
      const detail = reportError(issue.operation, issue.error);
      setInboxStatus(`Message previews could not be loaded (${detail.code}, HTTP ${detail.status}).`, true);
      renderConversationList();
      return false;
    }
    renderConversationList();
    setInboxStatus(conversations.length ? '' : 'No conversations have been started yet.');
    return true;
  };

  const loadThread = async (conversationId: string) => {
    selectedConversationId = conversationId;
    renderConversationList();
    const conversation = conversations.find((item) => item.id === conversationId);
    if (!conversation || !threadTitle || !threadStatus || !replyForm) return;
    threadTitle.textContent = `Visitor ${conversation.visitor_id.slice(0, 8)}`;
    threadStatus.hidden = false;
    threadStatus.className = `admin-thread__status admin-status admin-status--${conversation.status}`;
    threadStatus.textContent = conversation.status;
    replyForm.hidden = false;
    renderMessages([]);
    setInboxStatus('Loading message history…');
    const { data, error } = await supabase
      .from('messages')
      .select('id, conversation_id, sender, body, created_at')
      .eq('conversation_id', conversationId)
      .order('created_at', { ascending: true });
    if (error) {
      const detail = reportError('messages_select', error);
      setInboxStatus(`Message history could not be loaded (${detail.code}, HTTP ${detail.status}).`, true);
      return;
    }
    renderMessages((data ?? []) as ChatMessage[]);
    setInboxStatus('');
    replyInput?.focus();
  };

  const appendActiveMessage = (message: ChatMessage) => {
    if (message.conversation_id !== selectedConversationId || !messagesElement) return;
    if (messagesElement.querySelector(`[data-message-id="${message.id}"]`)) return;
    const history = Array.from(messagesElement.querySelectorAll<HTMLElement>('.admin-message')).map(() => null);
    if (!history.length) clearElement(messagesElement);
    const item = document.createElement('article');
    item.className = `admin-message admin-message--${message.sender}`;
    item.dataset.messageId = message.id;
    const meta = document.createElement('div');
    meta.className = 'admin-message__meta';
    const sender = document.createElement('strong');
    sender.textContent = message.sender === 'agent' ? 'You' : message.sender === 'visitor' ? 'Visitor' : 'System';
    const time = document.createElement('time');
    time.dateTime = message.created_at;
    time.textContent = formatTime(message.created_at);
    const body = document.createElement('p');
    body.textContent = message.body;
    meta.append(sender, time);
    item.append(meta, body);
    messagesElement.append(item);
    messagesElement.scrollTop = messagesElement.scrollHeight;
  };

  const startRealtime = () => {
    channel?.unsubscribe();
    channel = supabase
      .channel('admin-chat-inbox')
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages' }, (payload) => {
        const message = payload.new as ChatMessage;
        previews.set(message.conversation_id, message);
        renderConversationList();
        appendActiveMessage(message);
      })
      .subscribe((state) => {
        if (state === 'CHANNEL_ERROR' || state === 'TIMED_OUT') {
          console.error('[Admin chat]', { operation: 'realtime_subscribe', code: state, status: 0, message: 'Realtime subscription unavailable' });
          setInboxStatus('Live updates are unavailable. Refresh the inbox to check for new messages.', true);
        }
      });
  };

  const showInbox = async () => {
    login && (login.hidden = true);
    inbox && (inbox.hidden = false);
    const loaded = await loadConversations();
    if (loaded) startRealtime();
  };

  const validateSession = async () => {
    const { data, error } = await supabase.auth.getSession();
    if (error) {
      const detail = reportError('session_get', error);
      setLoginStatus(`Your session could not be checked (${detail.code}).`, true);
      return;
    }
    const user = data.session?.user;
    if (!user) return;
    if (user.id !== ADMIN_USER_ID) {
      await supabase.auth.signOut();
      setLoginStatus('This account is not authorised to access the chat inbox.', true);
      return;
    }
    await showInbox();
  };

  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const formData = new FormData(loginForm);
    const email = String(formData.get('email') ?? '').trim();
    const password = String(formData.get('password') ?? '');
    const button = loginForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!email || !password || !button) return;
    button.disabled = true;
    setLoginStatus('Signing in…');
    const { data, error } = await supabase.auth.signInWithPassword({ email, password });
    if (error || !data.user) {
      const detail = reportError('password_sign_in', error);
      setLoginStatus(`Sign in failed (${detail.code}, HTTP ${detail.status}).`, true);
      button.disabled = false;
      return;
    }
    if (data.user.id !== ADMIN_USER_ID) {
      await supabase.auth.signOut();
      setLoginStatus('This account is not authorised to access the chat inbox.', true);
      button.disabled = false;
      return;
    }
    await showInbox();
    button.disabled = false;
  });

  forgotPassword?.addEventListener('click', async () => {
    const email = String(new FormData(loginForm).get('email') ?? '').trim();
    if (!email) {
      setLoginStatus('Enter the authorised admin email address first.', true);
      loginForm?.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
      return;
    }
    forgotPassword.disabled = true;
    setLoginStatus('Sending a secure password-reset link…');
    // Supabase must have this exact local URL allow-listed in Auth → URL Configuration.
    // Production continues to use the domain currently serving the site.
    const redirectTo = import.meta.env.DEV
      ? 'http://localhost:4321/admin/reset-password'
      : new URL('/admin/reset-password', window.location.origin).toString();
    const { error } = await supabase.auth.resetPasswordForEmail(email, { redirectTo });
    if (error) {
      const detail = reportError('password_reset_request', error);
      setLoginStatus(`Password reset could not be requested (${detail.code}, HTTP ${detail.status}).`, true);
    } else {
      setLoginStatus('If this is the authorised admin email, a secure password-reset link has been sent. Check its inbox.');
    }
    forgotPassword.disabled = false;
  });

  list?.addEventListener('click', async (event) => {
    const target = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-conversation-id]');
    if (target?.dataset.conversationId) await loadThread(target.dataset.conversationId);
  });

  replyForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const body = replyInput?.value.trim();
    if (!body || !selectedConversationId || !replyInput) return;
    const button = replyForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!button) return;
    replyInput.disabled = true;
    button.disabled = true;
    const { data, error } = await supabase
      .from('messages')
      .insert({ conversation_id: selectedConversationId, sender: 'agent', body })
      .select('id, conversation_id, sender, body, created_at')
      .single();
    if (error || !data) {
      const detail = reportError('agent_reply_insert', error);
      setInboxStatus(`Your reply could not be sent (${detail.code}, HTTP ${detail.status}).`, true);
    } else {
      replyInput.value = '';
      appendActiveMessage(data as ChatMessage);
      previews.set(selectedConversationId, data as ChatMessage);
      renderConversationList();
      replyInput.focus();
    }
    replyInput.disabled = false;
    button.disabled = false;
  });

  signOut?.addEventListener('click', async () => {
    signOut.disabled = true;
    const { error } = await supabase.auth.signOut();
    if (error) {
      const detail = reportError('sign_out', error);
      setInboxStatus(`Sign out failed (${detail.code}).`, true);
      signOut.disabled = false;
      return;
    }
    if (channel) await supabase.removeChannel(channel);
    channel = null;
    conversations = [];
    previews.clear();
    selectedConversationId = null;
    clearElement(list);
    clearElement(messagesElement);
    replyForm && (replyForm.hidden = true);
    inbox && (inbox.hidden = true);
    login && (login.hidden = false);
    loginForm?.reset();
    setLoginStatus('You have been signed out.');
    signOut.disabled = false;
  });

  window.addEventListener('pagehide', () => {
    if (channel) supabase.removeChannel(channel);
  }, { once: true });

  void validateSession();
</script>

<style>
  .admin-chat { min-height:calc(100vh - 18rem); }
  .admin-chat__heading { max-width:46rem; margin-bottom:2rem; }
  .admin-login { width:min(100%, 32rem); padding:clamp(1.25rem, 3vw, 2rem); }
  .admin-login h2 { margin:0; color:var(--foreground); font-size:1.35rem; }
  .admin-login > p { margin:.45rem 0 1.35rem; color:var(--muted); }
  .admin-login__form { display:grid; gap:1rem; }
  .admin-login__form label { display:grid; gap:.4rem; color:var(--foreground); font-size:.9rem; font-weight:650; }
  .admin-login__form input, .admin-reply-form textarea { width:100%; border:1px solid var(--border); border-radius:.7rem; background:var(--background); color:var(--foreground); padding:.7rem .8rem; font:inherit; }
  .admin-login__status, .admin-inbox__status { min-height:1.4rem; margin:0; color:var(--muted); font-size:.88rem; }
  .admin-login__status.is-error, .admin-inbox__status.is-error { color:#fca5a5; }
  .admin-forgot-password { width:max-content; border:0; background:transparent; color:var(--primary); padding:0; font:650 .86rem/1.2 inherit; text-decoration:underline; text-underline-offset:.2rem; cursor:pointer; }
  .admin-forgot-password:hover { color:var(--foreground); }
  .admin-forgot-password:disabled { cursor:not-allowed; opacity:.6; }
  .admin-inbox__bar { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1rem 1.15rem; }
  .admin-inbox__bar .eyebrow { font-size:.64rem; }
  .admin-inbox__identity { margin:.25rem 0 0; color:var(--foreground); font-weight:700; }
  .admin-inbox__status { margin:.85rem 0; }
  .admin-inbox__layout { display:grid; grid-template-columns:minmax(16rem, .78fr) minmax(0, 1.7fr); gap:1rem; min-height:34rem; }
  .admin-conversations, .admin-thread { min-width:0; overflow:hidden; }
  .admin-panel-title, .admin-thread__header { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1rem 1.15rem; border-bottom:1px solid var(--border); }
  .admin-panel-title h2, .admin-thread h2 { margin:0; color:var(--foreground); font-size:1.05rem; }
  .admin-conversation-count { display:grid; min-width:1.75rem; min-height:1.75rem; place-items:center; border-radius:999px; background:rgb(56 217 245 / 14%); color:var(--primary); font-size:.78rem; font-weight:750; }
  .admin-conversation-list { display:grid; max-height:31rem; overflow-y:auto; }
  .admin-conversation { display:grid; gap:.3rem; width:100%; border:0; border-bottom:1px solid var(--border); background:transparent; color:var(--foreground); padding:.9rem 1rem; text-align:left; cursor:pointer; }
  .admin-conversation:hover, .admin-conversation.is-active { background:rgb(56 217 245 / 8%); }
  .admin-conversation.is-active { box-shadow:inset 3px 0 var(--primary); }
  .admin-conversation__top { display:flex; align-items:center; justify-content:space-between; gap:.5rem; }
  .admin-conversation strong { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:.84rem; }
  .admin-conversation__preview, .admin-conversation__time { overflow:hidden; color:var(--muted); font-size:.78rem; text-overflow:ellipsis; white-space:nowrap; }
  .admin-conversation__time { color:var(--muted-dark); font-size:.7rem; }
  .admin-status { display:inline-flex; width:max-content; align-items:center; border-radius:999px; padding:.2rem .48rem; font-size:.66rem; font-weight:750; line-height:1; text-transform:capitalize; }
  .admin-status--open { background:rgb(34 197 94 / 16%); color:#86efac; }
  .admin-status--closed { background:rgb(148 163 184 / 16%); color:#cbd5e1; }
  .admin-thread { display:grid; grid-template-rows:auto minmax(15rem, 1fr) auto; }
  .admin-thread__header .eyebrow { margin:0 0 .25rem; font-size:.64rem; }
  .admin-thread__messages { display:flex; min-height:20rem; flex-direction:column; gap:.75rem; overflow-y:auto; padding:1.15rem; }
  .admin-empty { margin:auto 0; color:var(--muted); font-size:.9rem; text-align:center; }
  .admin-message { max-width:min(88%, 42rem); padding:.7rem .8rem; border:1px solid var(--border); border-radius:.8rem; background:var(--card); }
  .admin-message--agent { align-self:flex-end; border-color:rgb(56 217 245 / 35%); background:rgb(56 217 245 / 10%); }
  .admin-message--system { align-self:center; }
  .admin-message__meta { display:flex; justify-content:space-between; gap:1rem; color:var(--muted); font-size:.68rem; }
  .admin-message__meta strong { color:var(--foreground); }
  .admin-message p { margin:.32rem 0 0; color:var(--foreground); overflow-wrap:anywhere; white-space:pre-wrap; font-size:.9rem; }
  .admin-reply-form { display:grid; grid-template-columns:minmax(0, 1fr) auto; align-items:end; gap:.75rem; padding:1rem 1.15rem; border-top:1px solid var(--border); }
  .admin-reply-form textarea { min-height:3rem; resize:vertical; }
  .admin-reply-form .btn { min-height:3rem; }
  @media (max-width: 760px) { .admin-inbox__layout { grid-template-columns:1fr; } .admin-conversation-list { max-height:18rem; } .admin-thread { min-height:32rem; } }
  @media (max-width: 480px) { .admin-inbox__bar, .admin-reply-form { align-items:stretch; flex-direction:column; grid-template-columns:1fr; } .admin-signout { width:100%; } .admin-message { max-width:94%; } }
</style>
