---
import { site, nav } from '../data/site';
---
<footer class="border-t border-border bg-[#050811]"><div class="shell grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]"><div><a href="/" class="text-lg font-bold text-foreground">OTT<span class="text-primary">/</span>INFRA</a><p class="mt-3 max-w-sm text-sm text-muted">IPTV & OTT Infrastructure Services<br />Build • Secure • Monitor • Optimize</p><p class="mt-4 text-xs text-muted-dark">Technical infrastructure, deployment and support services for authorized and licensed IPTV/OTT content and streaming platforms.</p></div><div><h2 class="text-sm font-bold text-foreground">Quick links</h2><div class="mt-3 grid grid-cols-2 gap-x-3 gap-y-2">{nav.slice(0,8).map(([label,href]) => <a class="text-sm text-muted hover:text-primary" href={href}>{label}</a>)}</div></div><div><h2 class="text-sm font-bold text-foreground">Connect</h2><div class="mt-3 grid gap-2 text-sm text-muted"><a class="hover:text-primary" href={site.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp: {site.phone}</a><a class="hover:text-primary" href={`mailto:${site.email}`}>{site.email}</a><a class="hover:text-primary" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a class="hover:text-primary" href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></div></div></div><div class="border-t border-border py-5 text-center text-xs text-muted-dark">© {new Date().getFullYear()} IPTV & OTT Infrastructure Services. All rights reserved.</div></footer>
