---
import { site, nav } from '../data/site';
import BrandMark from './BrandMark.astro';
---
<footer class="border-t border-border bg-[#050811]">
  <div class="shell grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a href="/" class="inline-flex items-center gap-2.5 text-lg font-extrabold tracking-tight text-foreground">
        <BrandMark class="size-8" idPrefix="footer" />
        <span class="flex items-baseline gap-2">
          <span>Plex<span class="text-primary">Tech</span></span>
          <span class="text-xs font-semibold tracking-wider text-muted uppercase">{site.subtitle}</span>
        </span>
      </a>
      <p class="mt-3 max-w-sm text-sm text-muted">
        <span class="font-semibold text-foreground">{site.domain}</span> — {site.tagline}
      </p>
      <p class="mt-4 max-w-md text-xs text-muted-dark">{site.disclaimer}</p>
    </div>

    <div>
      <h2 class="text-sm font-bold text-foreground">Quick links</h2>
      <div class="mt-3 grid grid-cols-2 gap-x-3 gap-y-2">
        {
          nav.slice(0, 8).map(([label, href]) => (
            <a class="text-sm text-muted hover:text-primary" href={href}>
              {label}
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <h2 class="text-sm font-bold text-foreground">Connect</h2>
      <div class="mt-3 grid gap-2 text-sm text-muted">
        <a class="hover:text-primary" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
          WhatsApp: {site.phone}
        </a>
        <a class="hover:text-primary" href={`mailto:${site.email}`}>
          {site.email}
        </a>
        <a class="hover:text-primary" href={site.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn
        </a>
        <a class="hover:text-primary" href={site.facebook} target="_blank" rel="noopener noreferrer">
          Facebook
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-border py-5 text-center text-xs text-muted-dark">
    © {new Date().getFullYear()} {site.name} ({site.domain}). All rights reserved.
  </div>
</footer>
