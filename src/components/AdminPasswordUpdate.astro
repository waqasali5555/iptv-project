<section class="password-update shell section" aria-labelledby="password-update-title">
  <div class="password-update__heading">
    <p class="eyebrow">Private workspace</p>
    <h1 id="password-update-title" class="section-title">Set a new password</h1>
    <p class="lede">Use a long, unique password for the authorised administrator account.</p>
  </div>

  <section class="password-update__panel surface" aria-live="polite">
    <p class="password-update__status">Validating your secure recovery link…</p>
    <form class="password-update__form" hidden>
      <label>
        <span>New password</span>
        <input name="password" type="password" autocomplete="new-password" minlength="12" required />
      </label>
      <label>
        <span>Confirm new password</span>
        <input name="confirmPassword" type="password" autocomplete="new-password" minlength="12" required />
      </label>
      <p class="password-update__hint">Use at least 12 characters. Do not reuse a password from another service.</p>
      <button class="btn btn-primary" type="submit">Update password</button>
    </form>
    <a class="btn btn-secondary password-update__signin" href="/admin/chat/" hidden>Return to sign in</a>
  </section>
</section>

<script>
  import { supabase } from '../lib/supabase';

  const ADMIN_USER_ID = 'e4530c3c-0a73-4569-84e1-791a9b5b1160';
  const root = document.querySelector<HTMLElement>('.password-update');
  const status = root?.querySelector<HTMLElement>('.password-update__status');
  const form = root?.querySelector<HTMLFormElement>('.password-update__form');
  const signInLink = root?.querySelector<HTMLAnchorElement>('.password-update__signin');

  const setStatus = (message: string, isError = false) => {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('is-error', isError);
  };

  const reportError = (operation: string, error: { code?: string; status?: number; message?: string } | null) => {
    const detail = { operation, code: error?.code ?? 'unknown', status: error?.status ?? 0, message: error?.message ?? 'Request failed' };
    console.error('[Admin password reset]', detail);
    return detail;
  };

  const rejectRecovery = async (message: string) => {
    await supabase.auth.signOut();
    form && (form.hidden = true);
    signInLink && (signInLink.hidden = false);
    setStatus(message, true);
  };

  const verifyRecoverySession = async () => {
    const url = new URL(window.location.href);
    const code = url.searchParams.get('code');
    // getSession waits for Supabase's built-in URL recovery handling first.
    // If it has already consumed the code, do not attempt a second exchange.
    const { data: initialSession, error: initialSessionError } = await supabase.auth.getSession();
    if (initialSessionError) reportError('password_recovery_session', initialSessionError);
    if (code && initialSession.session?.user.id !== ADMIN_USER_ID) {
      const { error } = await supabase.auth.exchangeCodeForSession(code);
      if (error) {
        const detail = reportError('password_recovery_exchange', error);
        await rejectRecovery(`This recovery link is invalid or expired (${detail.code}). Request a new one.`);
        return;
      }
    }

    // The recovery code is one-time and is never retained in the browser URL.
    if (code || window.location.hash) window.history.replaceState({}, document.title, url.pathname);

    const { data, error } = await supabase.auth.getUser();
    if (error || !data.user) {
      if (error) reportError('password_recovery_session', error);
      await rejectRecovery('This recovery link is invalid or expired. Request a new one from the admin sign-in page.');
      return;
    }
    if (data.user.id !== ADMIN_USER_ID) {
      await rejectRecovery('This account is not authorised to update the administrator password.');
      return;
    }
    form && (form.hidden = false);
    setStatus('Your recovery link is verified. Choose a new password.');
    form?.querySelector<HTMLInputElement>('input[name="password"]')?.focus();
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const password = String(new FormData(form).get('password') ?? '');
    const confirmation = String(new FormData(form).get('confirmPassword') ?? '');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (password.length < 12) {
      setStatus('Use a password with at least 12 characters.', true);
      return;
    }
    if (password !== confirmation) {
      setStatus('The two passwords do not match.', true);
      return;
    }
    if (!button) return;
    button.disabled = true;
    setStatus('Updating password…');
    const { error } = await supabase.auth.updateUser({ password });
    if (error) {
      const detail = reportError('password_update', error);
      setStatus(`Password update failed (${detail.code}, HTTP ${detail.status}).`, true);
      button.disabled = false;
      return;
    }
    await supabase.auth.signOut();
    form.hidden = true;
    signInLink && (signInLink.hidden = false);
    setStatus('Password updated. Sign in again with your new password.');
  });

  void verifyRecoverySession();
</script>

<style>
  .password-update { min-height:calc(100vh - 18rem); }
  .password-update__heading { max-width:44rem; margin-bottom:2rem; }
  .password-update__panel { display:grid; width:min(100%, 32rem); gap:1rem; padding:clamp(1.25rem, 3vw, 2rem); }
  .password-update__status { min-height:1.5rem; margin:0; color:var(--muted); }
  .password-update__status.is-error { color:#fca5a5; }
  .password-update__form { display:grid; gap:1rem; }
  .password-update__form label { display:grid; gap:.4rem; color:var(--foreground); font-size:.9rem; font-weight:650; }
  .password-update__form input { width:100%; border:1px solid var(--border); border-radius:.7rem; background:var(--background); color:var(--foreground); padding:.7rem .8rem; font:inherit; }
  .password-update__hint { margin:0; color:var(--muted); font-size:.85rem; }
  .password-update__signin { width:max-content; }
</style>
