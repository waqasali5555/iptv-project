---
interface Props { eyebrow?: string; title: string; text?: string; align?: 'left' | 'center' }
const { eyebrow, title, text, align = 'left' } = Astro.props;
---
<div class:list={[align === 'center' && 'mx-auto text-center', 'max-w-3xl']}><p class:list={['eyebrow', align==='center' && 'justify-center']}>{eyebrow}</p><h2 class="section-title">{title}</h2>{text && <p class="lede">{text}</p>}</div>
