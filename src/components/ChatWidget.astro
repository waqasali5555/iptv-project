<section class="chat-widget" aria-label="Customer support chat">
  <button class="chat-launcher" type="button" aria-expanded="false" aria-controls="live-chat-panel">
    <span aria-hidden="true">◌</span>
    <span>Chat with us</span>
  </button>

  <div id="live-chat-panel" class="chat-panel" hidden>
    <div class="chat-panel__header">
      <div>
        <p class="chat-panel__eyebrow">Technical support</p>
        <h2>How can we help?</h2>
      </div>
      <button class="chat-close" type="button" aria-label="Close chat">×</button>
    </div>

    <div class="chat-messages" aria-live="polite" aria-busy="false">
      <p class="chat-state">Open the chat to start a secure support conversation.</p>
    </div>

    <form class="chat-form">
      <label class="sr-only" for="chat-message">Your message</label>
      <textarea id="chat-message" name="message" rows="2" maxlength="4000" placeholder="Describe your infrastructure or streaming issue…" required disabled></textarea>
      <button class="chat-send" type="submit" disabled>Send <span aria-hidden="true">↗</span></button>
    </form>
  </div>
</section>

<script>
  import { supabase } from '../lib/supabase';

  const launcher = document.querySelector<HTMLButtonElement>('.chat-launcher');
  const panel = document.querySelector<HTMLElement>('#live-chat-panel');
  const closeButton = document.querySelector<HTMLButtonElement>('.chat-close');
  const form = document.querySelector<HTMLFormElement>('.chat-form');
  const input = document.querySelector<HTMLTextAreaElement>('#chat-message');
  const sendButton = document.querySelector<HTMLButtonElement>('.chat-send');
  const messagesElement = document.querySelector<HTMLElement>('.chat-messages');

  type ChatMessage = { id: string; sender: 'visitor' | 'agent' | 'system'; body: string; created_at: string };
  let conversationId: string | null = null;
  let subscription: ReturnType<typeof supabase.channel> | null = null;
  let initialized = false;

  const setState = (message: string, isError = false) => {
    if (!messagesElement) return;
    messagesElement.innerHTML = `<p class="chat-state${isError ? ' chat-state--error' : ''}">${message}</p>`;
  };

  const renderMessages = (messages: ChatMessage[]) => {
    if (!messagesElement) return;
    if (messages.length === 0) {
      setState('Send a message and our technical team will reply here.');
      return;
    }
    messagesElement.innerHTML = messages.map((message) => `
      <article class="chat-message chat-message--${message.sender}">
        <p>${message.body.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[character] || character)}</p>
        <span>${message.sender === 'agent' ? 'Support team' : 'You'}</span>
      </article>
    `).join('');
    messagesElement.scrollTop = messagesElement.scrollHeight;
  };

  const appendMessage = (message: ChatMessage) => {
    const existing = messagesElement?.querySelector(`[data-message-id="${message.id}"]`);
    if (existing || !messagesElement) return;
    const state = messagesElement.querySelector('.chat-state');
    state?.remove();
    const item = document.createElement('article');
    item.className = `chat-message chat-message--${message.sender}`;
    item.dataset.messageId = message.id;
    const body = document.createElement('p');
    body.textContent = message.body;
    const sender = document.createElement('span');
    sender.textContent = message.sender === 'agent' ? 'Support team' : 'You';
    item.append(body, sender);
    messagesElement.append(item);
    messagesElement.scrollTop = messagesElement.scrollHeight;
  };

  const loadChat = async () => {
    if (!messagesElement || !input || !sendButton) return;
    messagesElement.setAttribute('aria-busy', 'true');
    setState('Connecting to support…');

    const { data: sessionData, error: sessionError } = await supabase.auth.getSession();
    let user = sessionData.session?.user;
    if (!user && !sessionError) {
      const { data, error } = await supabase.auth.signInAnonymously();
      if (error) {
        setState('Chat is unavailable right now. Please use WhatsApp or email.', true);
        messagesElement.setAttribute('aria-busy', 'false');
        return;
      }
      user = data.user;
    }

    if (!user) {
      setState('Chat is unavailable right now. Please use WhatsApp or email.', true);
      messagesElement.setAttribute('aria-busy', 'false');
      return;
    }

    const { data: existingConversation, error: conversationError } = await supabase
      .from('conversations')
      .select('id')
      .eq('visitor_id', user.id)
      .order('last_message_at', { ascending: false })
      .limit(1)
      .maybeSingle();

    if (conversationError) {
      setState('Chat is unavailable right now. Please use WhatsApp or email.', true);
      messagesElement.setAttribute('aria-busy', 'false');
      return;
    }

    if (existingConversation) {
      conversationId = existingConversation.id;
    } else {
      const { data, error } = await supabase
        .from('conversations')
        .insert({ visitor_id: user.id })
        .select('id')
        .single();
      if (error || !data) {
        setState('Chat is unavailable right now. Please use WhatsApp or email.', true);
        messagesElement.setAttribute('aria-busy', 'false');
        return;
      }
      conversationId = data.id;
    }

    const { data: history, error: historyError } = await supabase
      .from('messages')
      .select('id, sender, body, created_at')
      .eq('conversation_id', conversationId)
      .order('created_at', { ascending: true });

    if (historyError) {
      setState('Chat history could not be loaded. Please use WhatsApp or email.', true);
      messagesElement.setAttribute('aria-busy', 'false');
      return;
    }

    renderMessages((history ?? []) as ChatMessage[]);
    subscription = supabase
      .channel(`conversation:${conversationId}`)
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages', filter: `conversation_id=eq.${conversationId}` }, (payload) => appendMessage(payload.new as ChatMessage))
      .subscribe();

    input.disabled = false;
    sendButton.disabled = false;
    messagesElement.setAttribute('aria-busy', 'false');
  };

  launcher?.addEventListener('click', async () => {
    const opening = panel?.hidden;
    if (!panel) return;
    panel.hidden = !opening;
    launcher.setAttribute('aria-expanded', String(opening));
    if (opening && !initialized) {
      initialized = true;
      await loadChat();
    }
    if (opening) input?.focus();
  });

  closeButton?.addEventListener('click', () => {
    if (!panel) return;
    panel.hidden = true;
    launcher?.setAttribute('aria-expanded', 'false');
    launcher?.focus();
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const body = input?.value.trim();
    if (!body || !conversationId || !input || !sendButton) return;
    input.disabled = true;
    sendButton.disabled = true;
    const { data, error } = await supabase
      .from('messages')
      .insert({ conversation_id: conversationId, sender: 'visitor', body })
      .select('id, sender, body, created_at')
      .single();
    if (error || !data) {
      setState('Your message could not be sent. Please try again or use WhatsApp.', true);
    } else {
      input.value = '';
      appendMessage(data as ChatMessage);
    }
    input.disabled = false;
    sendButton.disabled = false;
    input.focus();
  });

  window.addEventListener('pagehide', () => {
    if (subscription) supabase.removeChannel(subscription);
  }, { once: true });
</script>

<style>
  .chat-widget { position:fixed; right:1rem; bottom:1rem; z-index:50; font-family:inherit; }
  .chat-launcher { display:inline-flex; min-height:3rem; align-items:center; gap:.5rem; border:0; border-radius:999px; background:var(--primary); color:#020617; padding:.7rem 1.05rem; font:700 .875rem/1 inherit; box-shadow:0 12px 28px rgb(2 6 23 / 22%); cursor:pointer; transition:transform .2s, background .2s; }
  .chat-launcher:hover { background:#5ce2f7; transform:translateY(-2px); }
  .chat-panel { position:absolute; right:0; bottom:3.8rem; display:grid; width:min(23rem, calc(100vw - 2rem)); max-height:min(39rem, calc(100vh - 6rem)); grid-template-rows:auto minmax(12rem,1fr) auto; overflow:hidden; border:1px solid var(--border); border-radius:1rem; background:var(--card); box-shadow:0 22px 55px rgb(2 6 23 / 30%); }
  .chat-panel[hidden] { display:none; }
  .chat-panel__header { display:flex; align-items:start; justify-content:space-between; gap:1rem; padding:1rem 1rem .85rem; border-bottom:1px solid var(--border); background:var(--card-elevated); }
  .chat-panel__eyebrow { margin:0 0 .15rem; color:var(--primary); font-size:.68rem; font-weight:750; letter-spacing:.1em; text-transform:uppercase; }
  .chat-panel h2 { margin:0; color:var(--foreground); font-size:1.05rem; line-height:1.25; }
  .chat-close { display:grid; width:2rem; height:2rem; place-items:center; border:1px solid var(--border); border-radius:.5rem; background:transparent; color:var(--muted); font-size:1.4rem; line-height:1; cursor:pointer; }
  .chat-messages { display:flex; min-height:14rem; flex-direction:column; gap:.65rem; overflow-y:auto; padding:1rem; }
  .chat-state { margin:auto 0; color:var(--muted); font-size:.9rem; text-align:center; }
  .chat-state--error { color:#fca5a5; }
  .chat-message { max-width:85%; padding:.65rem .75rem; border-radius:.75rem; background:var(--card-elevated); color:var(--foreground); }
  .chat-message--visitor { align-self:flex-end; background:color-mix(in srgb, var(--primary) 18%, var(--card)); }
  .chat-message--agent { align-self:flex-start; border:1px solid var(--border); }
  .chat-message p { margin:0; overflow-wrap:anywhere; font-size:.9rem; }
  .chat-message span { display:block; margin-top:.3rem; color:var(--muted); font-size:.68rem; font-weight:650; }
  .chat-form { display:grid; grid-template-columns:1fr auto; gap:.6rem; padding: .85rem 1rem 1rem; border-top:1px solid var(--border); background:var(--card); }
  .chat-form textarea { min-width:0; resize:none; border:1px solid var(--border); border-radius:.65rem; background:var(--background); color:var(--foreground); padding:.6rem .7rem; font:inherit; font-size:.85rem; }
  .chat-form textarea::placeholder { color:var(--muted); }
  .chat-send { align-self:end; min-height:2.45rem; border:0; border-radius:.6rem; background:var(--primary); color:#020617; padding:.5rem .75rem; font:700 .8rem/1 inherit; cursor:pointer; }
  .chat-send:disabled, .chat-form textarea:disabled { cursor:not-allowed; opacity:.6; }
  @media (max-width: 640px) { .chat-widget { right:.75rem; bottom:.75rem; } .chat-panel { bottom:3.6rem; width:calc(100vw - 1.5rem); } }
  @media (prefers-reduced-motion: reduce) { .chat-launcher { transition:none; } }
</style>
