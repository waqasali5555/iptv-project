---
import SectionHeader from './SectionHeader.astro';
import { caseStudies } from '../data/site';
---
<section id="case-studies" class="section">
  <div class="shell">
    <SectionHeader
      eyebrow="Case Studies"
      title="Proven Engineering Outcomes"
      text="Real-world production bottlenecks resolved across live OTT delivery, CGNAT media servers, ZFS NAS arrays, and 24/7 observability."
    />

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        caseStudies.map((study, index) => (
          <article class="card flex flex-col justify-between gap-5 p-6">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="tag">{study.tag}</span>
                <span class="rounded-full border border-success/35 bg-success/10 px-3 py-1 text-xs font-bold text-green-300">
                  {study.metric}
                </span>
              </div>
              <h3 class="mt-4 text-xl font-bold text-foreground">
                <span class="mr-2 text-sm font-bold text-primary">
                  {String(index + 1).padStart(2, '0')}
                </span>
                {study.title}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-muted">{study.summary}</p>
            </div>

            <div class="flex flex-wrap gap-2 border-t border-border/70 pt-4">
              {study.stack.map((tech) => (
                <span class="rounded-md border border-border bg-secondary-bg px-2.5 py-1 text-xs font-semibold text-slate-300">
                  {tech}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
