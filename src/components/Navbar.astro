---
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-border bg-background/80 backdrop-blur-xl"><div class="shell flex min-h-18 items-center justify-between gap-4"><a href="/" class="flex items-center gap-2 font-bold tracking-tight text-foreground"><span class="grid size-8 place-items-center rounded-lg bg-primary text-sm text-ink">◈</span><span class="hidden sm:block">OTT<span class="text-primary">/</span>INFRA</span></a><nav class="hidden items-center gap-5 xl:flex" aria-label="Primary navigation">{nav.map(([label,href]) => <a href={href} class:list={['text-[.78rem] font-semibold text-muted hover:text-foreground', path===href && 'text-primary']} >{label}</a>)}</nav><a class="btn btn-primary hidden min-h-10 px-3 text-xs sm:inline-flex" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Free Consultation</a><details class="relative xl:hidden"><summary class="cursor-pointer list-none rounded-md border border-border px-3 py-2 text-sm text-foreground" aria-label="Open navigation">Menu</summary><nav class="absolute right-0 mt-3 grid w-72 gap-1 rounded-xl border border-border bg-secondary-bg p-3 shadow-2xl">{nav.map(([label,href]) => <a href={href} class="rounded-md px-3 py-2 text-sm text-muted hover:bg-card-elevated hover:text-foreground">{label}</a>)}<a class="btn btn-primary mt-2 text-sm" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Free Consultation</a></nav></details></div></header>
