---
import { nav, site } from '../data/site';
import BrandMark from './BrandMark.astro';
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-border bg-background/80 backdrop-blur-xl">
  <div class="shell flex min-h-18 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight text-foreground">
      <BrandMark class="size-9" idPrefix="nav" />
      <span class="flex flex-col leading-none">
        <span class="text-base font-extrabold tracking-tight">
          Plex<span class="text-primary">Tech</span>
        </span>
        <span class="hidden text-[0.65rem] font-semibold tracking-[0.08em] text-muted uppercase sm:block">
          {site.subtitle}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-3.5 xl:flex 2xl:gap-5" aria-label="Primary navigation">
      {
        nav.map(([label, href]) => (
          <a
            href={href}
            class:list={[
              'whitespace-nowrap text-[.76rem] font-semibold text-muted hover:text-foreground',
              (path === href || (href !== '/' && path.startsWith(href))) && 'text-primary',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-open-consultation
        class="btn btn-primary hidden min-h-10 cursor-pointer px-3.5 text-xs sm:inline-flex"
      >
        Free Consultation
      </button>

      <details class="relative xl:hidden">
        <summary
          class="cursor-pointer list-none rounded-md border border-border px-3 py-2 text-sm text-foreground"
          aria-label="Open navigation"
        >
          Menu
        </summary>
        <nav class="absolute right-0 mt-3 grid w-72 gap-1 rounded-xl border border-border bg-secondary-bg p-3 shadow-2xl">
          {
            nav.map(([label, href]) => (
              <a
                href={href}
                class:list={[
                  'rounded-md px-3 py-2 text-sm text-muted hover:bg-card-elevated hover:text-foreground',
                  path === href && 'bg-card-elevated text-primary',
                ]}
              >
                {label}
              </a>
            ))
          }
          <a
            class="btn btn-primary mt-2 text-sm"
            href={site.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp {site.phone}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
