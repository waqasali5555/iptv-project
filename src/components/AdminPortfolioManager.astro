<section class="admin-cms-panel w-full min-w-0" aria-labelledby="admin-portfolio-heading">
  <div class="grid min-w-0 gap-6 xl:grid-cols-[1.05fr_0.95fr]">
    <form id="admin-portfolio-form" class="surface grid w-full min-w-0 gap-4 p-5 md:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border pb-4">
        <div>
          <p class="eyebrow">Portfolio CMS</p>
          <h2 id="admin-portfolio-heading" class="mt-1.5 text-xl font-bold text-foreground">
            Create / Edit Portfolio Item
          </h2>
        </div>
        <button type="button" id="portfolio-reset-btn" class="btn btn-secondary min-h-9 cursor-pointer px-3 text-xs">
          New Project
        </button>
      </div>

      <input type="hidden" id="portfolio-id" name="id" />

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
          Title
          <input
            id="portfolio-title"
            name="title"
            type="text"
            required
            placeholder="Peak-Hour HLS Origin & CDN Overhaul"
            class="rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
          />
        </label>

        <label class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
          Category
          <select
            id="portfolio-category"
            name="category"
            class="rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
          >
            <option value="IPTV & OTT">IPTV &amp; OTT</option>
            <option value="Plex & Unraid">Plex &amp; Unraid</option>
            <option value="NAS & DevOps">NAS &amp; DevOps</option>
          </select>
        </label>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
          Client Type
          <input
            id="portfolio-client"
            name="client_type"
            type="text"
            required
            placeholder="Licensed OTT Broadcaster / SMB"
            class="rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
          />
        </label>

        <label class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
          Outcome Metric
          <input
            id="portfolio-metric"
            name="outcome_metric"
            type="text"
            required
            placeholder="99.95% Uptime / 40TB Zero Loss"
            class="rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
          />
        </label>
      </div>

      <label class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
        Tech Stack (comma-separated)
        <input
          id="portfolio-stack"
          name="tech_stack"
          type="text"
          required
          placeholder="FFmpeg ABR, NVIDIA NVENC, Nginx Cache, TCP BBR"
          class="rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
        />
      </label>

      <div class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
        <span>Screenshot / Architecture Image (plextech-media)</span>
        <div class="flex items-center gap-2">
          <input
            id="portfolio-image-url"
            name="image_url"
            type="url"
            placeholder="https://.../screenshot.png"
            class="min-w-0 flex-1 rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
          />
          <label class="btn btn-secondary min-h-10 shrink-0 cursor-pointer px-3 text-xs">
            Upload
            <input id="portfolio-image-file" type="file" accept="image/*" class="sr-only" />
          </label>
        </div>
      </div>

      <div id="portfolio-image-preview-wrap" class="hidden overflow-hidden rounded-xl border border-border bg-background p-2">
        <img id="portfolio-image-preview" src="" alt="Portfolio screenshot preview" class="max-h-40 w-full rounded-lg object-cover" />
      </div>

      <label class="grid gap-1.5 text-xs font-semibold tracking-wide text-foreground uppercase">
        Summary
        <textarea
          id="portfolio-summary"
          name="summary"
          rows="4"
          required
          placeholder="Describe the bottleneck, architecture fix, and measurable outcome…"
          class="rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-normal text-foreground"
        ></textarea>
      </label>

      <label class="inline-flex w-max cursor-pointer items-center gap-2.5 text-sm font-semibold text-foreground">
        <input id="portfolio-published" name="published" type="checkbox" checked class="size-4 accent-primary" />
        <span>Published (visible publicly on /portfolio)</span>
      </label>

      <p id="admin-portfolio-status" class="min-h-5 text-xs text-muted" aria-live="polite"></p>

      <div class="flex flex-wrap gap-3">
        <button type="submit" id="portfolio-save-btn" class="btn btn-primary cursor-pointer">
          Save Portfolio Item
        </button>
      </div>
    </form>

    <aside class="surface flex w-full min-w-0 flex-col overflow-hidden">
      <div class="flex items-center justify-between gap-3 border-b border-border px-5 py-4">
        <div class="min-w-0">
          <h3 class="text-base font-bold text-foreground">All Portfolio Items</h3>
          <p class="text-xs text-muted">Published and hidden case studies</p>
        </div>
        <span
          id="admin-portfolio-count"
          class="inline-grid min-h-7 min-w-7 shrink-0 place-items-center rounded-full bg-cyan-500/15 px-2 text-xs font-bold text-cyan-300"
        >
          0
        </span>
      </div>

      <div id="admin-portfolio-seed-wrap" class="hidden border-b border-border bg-primary/5 p-4">
        <p class="text-xs text-muted">No portfolio items in Supabase yet.</p>
        <button type="button" id="portfolio-seed-btn" class="btn btn-secondary mt-2 min-h-9 cursor-pointer px-3 text-xs">
          Seed 2 Starter Portfolio Items
        </button>
      </div>

      <div id="admin-portfolio-list" class="flex max-h-[44rem] w-full min-w-0 flex-col gap-3 overflow-y-auto p-4">
        <p class="text-sm text-muted">Sign in to manage portfolio items.</p>
      </div>
    </aside>
  </div>
</section>

<script>
  import { supabase } from '../lib/supabase';
  import { MEDIA_BUCKET, SEED_PORTFOLIO_ITEMS, type CmsCategory, type PortfolioItem } from '../lib/cms';

  const form = document.getElementById('admin-portfolio-form') as HTMLFormElement | null;
  const idInput = document.getElementById('portfolio-id') as HTMLInputElement | null;
  const titleInput = document.getElementById('portfolio-title') as HTMLInputElement | null;
  const categorySelect = document.getElementById('portfolio-category') as HTMLSelectElement | null;
  const clientInput = document.getElementById('portfolio-client') as HTMLInputElement | null;
  const metricInput = document.getElementById('portfolio-metric') as HTMLInputElement | null;
  const stackInput = document.getElementById('portfolio-stack') as HTMLInputElement | null;
  const imageUrlInput = document.getElementById('portfolio-image-url') as HTMLInputElement | null;
  const imageFileInput = document.getElementById('portfolio-image-file') as HTMLInputElement | null;
  const imagePreviewWrap = document.getElementById('portfolio-image-preview-wrap');
  const imagePreviewImg = document.getElementById('portfolio-image-preview') as HTMLImageElement | null;
  const summaryInput = document.getElementById('portfolio-summary') as HTMLTextAreaElement | null;
  const publishedInput = document.getElementById('portfolio-published') as HTMLInputElement | null;
  const resetBtn = document.getElementById('portfolio-reset-btn');
  const saveBtn = document.getElementById('portfolio-save-btn') as HTMLButtonElement | null;
  const statusEl = document.getElementById('admin-portfolio-status');
  const listEl = document.getElementById('admin-portfolio-list');
  const countEl = document.getElementById('admin-portfolio-count');
  const seedWrap = document.getElementById('admin-portfolio-seed-wrap');
  const seedBtn = document.getElementById('portfolio-seed-btn') as HTMLButtonElement | null;

  let items: PortfolioItem[] = [];

  const setStatus = (msg: string, isError = false) => {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.className = `min-h-5 text-xs ${isError ? 'text-red-300' : 'text-muted'}`;
  };

  const updateImagePreview = (url: string) => {
    if (!imagePreviewWrap || !imagePreviewImg) return;
    if (url.trim()) {
      imagePreviewImg.src = url.trim();
      imagePreviewWrap.classList.remove('hidden');
    } else {
      imagePreviewImg.src = '';
      imagePreviewWrap.classList.add('hidden');
    }
  };

  const resetForm = () => {
    form?.reset();
    if (idInput) idInput.value = '';
    if (publishedInput) publishedInput.checked = true;
    updateImagePreview('');
    setStatus('');
  };

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch] || ch);

  const renderList = () => {
    if (!listEl || !countEl) return;
    countEl.textContent = String(items.length);
    if (seedWrap) seedWrap.classList.toggle('hidden', items.length > 0);

    if (!items.length) {
      listEl.innerHTML = '<p class="text-sm text-slate-300">No portfolio items found.</p>';
      return;
    }

    listEl.innerHTML = items
      .map(
        (item) => `
      <article class="w-full min-w-0 bg-slate-900/80 border border-slate-800 text-slate-100 rounded-xl p-4 flex flex-col gap-3" data-portfolio-id="${escapeHtml(item.id)}">
        <div class="flex items-start justify-between gap-3 min-w-0">
          <div class="min-w-0 flex-1">
            <h4 class="text-sm font-bold text-slate-100 break-words">${escapeHtml(item.title)}</h4>
            <p class="mt-1 text-xs text-slate-400 break-words">${escapeHtml(item.category)} • ${escapeHtml(item.outcome_metric)}</p>
          </div>
          <span class="shrink-0 inline-flex items-center rounded-full px-2.5 py-1 text-[0.7rem] font-bold ${
            item.published
              ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40'
              : 'bg-slate-800 text-slate-300 border border-slate-700'
          }">
            ${item.published ? 'Published' : 'Draft'}
          </span>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-800/80 pt-3">
          <span class="min-w-0 flex-1 truncate text-[0.7rem] text-slate-400">${escapeHtml((item.tech_stack || []).join(', '))}</span>
          <div class="flex flex-wrap gap-1.5">
            <button type="button" data-portfolio-action="edit" data-id="${escapeHtml(item.id)}" class="cursor-pointer rounded-md border border-slate-700 bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-100 hover:border-cyan-400">Edit</button>
            <button type="button" data-portfolio-action="toggle" data-id="${escapeHtml(item.id)}" class="cursor-pointer rounded-md border border-cyan-500/40 bg-cyan-500/15 px-2.5 py-1 text-xs font-semibold text-cyan-300 hover:bg-cyan-500/25">${item.published ? 'Unpublish' : 'Publish'}</button>
            <a href="/portfolio/" target="_blank" rel="noopener noreferrer" class="rounded-md border border-slate-700 bg-slate-800/60 px-2.5 py-1 text-xs font-semibold text-slate-200 hover:border-cyan-400 hover:text-white">View</a>
            <button type="button" data-portfolio-action="delete" data-id="${escapeHtml(item.id)}" class="cursor-pointer rounded-md border border-red-500/40 bg-red-500/15 px-2.5 py-1 text-xs font-semibold text-red-300 hover:bg-red-500/25">Delete</button>
          </div>
        </div>
      </article>
    `,
      )
      .join('');
  };

  const loadItems = async () => {
    setStatus('Loading portfolio items…');
    const { data, error } = await supabase
      .from('portfolio_items')
      .select('*')
      .order('created_at', { ascending: false });

    if (error) {
      setStatus(`Could not load portfolio items (${error.code ?? 'error'}: ${error.message}).`, true);
      return;
    }

    items = (data ?? []) as PortfolioItem[];
    renderList();
    setStatus('');
  };

  imageUrlInput?.addEventListener('input', () => {
    updateImagePreview(imageUrlInput.value);
  });

  imageFileInput?.addEventListener('change', async () => {
    const file = imageFileInput.files?.[0];
    if (!file) return;
    setStatus('Uploading screenshot to plextech-media…');
    const safeName = `${Date.now()}-${file.name.replace(/[^a-zA-Z0-9._-]+/g, '-')}`;
    const filePath = `portfolio/${safeName}`;

    const { error } = await supabase.storage.from(MEDIA_BUCKET).upload(filePath, file, {
      cacheControl: '3600',
      upsert: false,
    });

    if (error) {
      setStatus(`Image upload failed: ${error.message}`, true);
      return;
    }

    const { data } = supabase.storage.from(MEDIA_BUCKET).getPublicUrl(filePath);
    if (imageUrlInput) imageUrlInput.value = data.publicUrl;
    updateImagePreview(data.publicUrl);
    setStatus('Screenshot uploaded.');
    imageFileInput.value = '';
  });

  resetBtn?.addEventListener('click', resetForm);

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!titleInput || !categorySelect || !clientInput || !metricInput || !stackInput || !summaryInput || !saveBtn) return;

    saveBtn.disabled = true;
    setStatus('Saving portfolio item…');

    const techStack = stackInput.value
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);

    const payload = {
      title: titleInput.value.trim(),
      category: categorySelect.value as CmsCategory,
      client_type: clientInput.value.trim(),
      outcome_metric: metricInput.value.trim(),
      tech_stack: techStack,
      summary: summaryInput.value.trim(),
      image_url: imageUrlInput?.value.trim() || null,
      published: Boolean(publishedInput?.checked),
    };

    const existingId = idInput?.value.trim();
    const result = existingId
      ? await supabase.from('portfolio_items').update(payload).eq('id', existingId)
      : await supabase.from('portfolio_items').insert(payload);

    if (result.error) {
      setStatus(`Save failed: ${result.error.message}`, true);
      saveBtn.disabled = false;
      return;
    }

    await loadItems();
    resetForm();
    setStatus(existingId ? 'Portfolio item updated.' : 'Portfolio item created.');
    saveBtn.disabled = false;
  });

  listEl?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-portfolio-action]');
    const id = button?.dataset.id;
    const action = button?.dataset.portfolioAction;
    if (!id || !action) return;

    const item = items.find((entry) => entry.id === id);
    if (!item) return;

    if (action === 'edit') {
      if (idInput) idInput.value = item.id;
      if (titleInput) titleInput.value = item.title;
      if (categorySelect) categorySelect.value = item.category;
      if (clientInput) clientInput.value = item.client_type;
      if (metricInput) metricInput.value = item.outcome_metric;
      if (stackInput) stackInput.value = (item.tech_stack || []).join(', ');
      if (imageUrlInput) imageUrlInput.value = item.image_url || '';
      updateImagePreview(item.image_url || '');
      if (summaryInput) summaryInput.value = item.summary;
      if (publishedInput) publishedInput.checked = item.published;
      setStatus(`Editing "${item.title}"`);
      titleInput?.focus();
      return;
    }

    if (action === 'toggle') {
      const { error } = await supabase
        .from('portfolio_items')
        .update({ published: !item.published })
        .eq('id', item.id);
      if (error) {
        setStatus(`Status update failed: ${error.message}`, true);
        return;
      }
      await loadItems();
      setStatus(`Item ${!item.published ? 'published' : 'hidden'}.`);
      return;
    }

    if (action === 'delete') {
      if (!window.confirm(`Delete "${item.title}"? This cannot be undone.`)) return;
      const { error } = await supabase.from('portfolio_items').delete().eq('id', item.id);
      if (error) {
        setStatus(`Delete failed: ${error.message}`, true);
        return;
      }
      if (idInput?.value === item.id) resetForm();
      await loadItems();
      setStatus('Portfolio item deleted.');
    }
  });

  seedBtn?.addEventListener('click', async () => {
    if (!seedBtn) return;
    seedBtn.disabled = true;
    setStatus('Seeding starter portfolio items…');
    const rows = SEED_PORTFOLIO_ITEMS.map((item) => ({
      title: item.title,
      category: item.category,
      client_type: item.client_type,
      summary: item.summary,
      tech_stack: item.tech_stack,
      outcome_metric: item.outcome_metric,
      image_url: item.image_url,
      published: item.published,
    }));
    const { error } = await supabase.from('portfolio_items').insert(rows);
    if (error) {
      setStatus(`Seed failed: ${error.message}`, true);
    } else {
      await loadItems();
      setStatus('Starter portfolio items seeded.');
    }
    seedBtn.disabled = false;
  });

  window.addEventListener('plextech:admin-auth', (event) => {
    const detail = (event as CustomEvent<{ authenticated?: boolean }>).detail;
    if (detail?.authenticated) {
      void loadItems();
    } else {
      items = [];
      renderList();
      resetForm();
    }
  });
</script>
