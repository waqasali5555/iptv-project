---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';

const items = [
  ['Linux & NAS hardening', 'Reduce avoidable exposure with key-based SSH, sensible defaults, and routine security patching.'],
  ['Firewall, Tailscale & WireGuard', 'Replace open risky ports with encrypted Tailscale/WireGuard mesh access and strict firewall rules.'],
  ['SSL/TLS & reverse proxy security', 'Protect streams and Plex/NAS dashboards in transit with automated TLS and Nginx hardening.'],
  ['Prometheus, Grafana & Telegram alerts', 'Turn stream health, GPU load, disk SMART, and backup status into instant Telegram alerts.'],
  ['Log management with Loki', 'Aggregate container, Nginx, and FFmpeg logs for rapid root-cause diagnosis.'],
  ['DDoS & CDN edge protection', 'Apply Cloudflare and origin-shielding protections tailored to your delivery profile.'],
];
---
<BaseLayout
  title={`Security & Monitoring | ${site.name} — Grafana, Prometheus & Hardening`}
  description="Linux and NAS hardening, Tailscale/WireGuard VPN, SSL/TLS, Cloudflare, Prometheus, Grafana, Loki, and Telegram alerting by PlexTech."
>
  <PageHero
    eyebrow="Security & Monitoring"
    title="Know what your infrastructure is doing."
    text="Security controls and 24/7 observability that protect authorized streaming platforms, Plex servers, and NAS arrays."
  />
  <section class="section">
    <div class="shell">
      <div class="grid-cards">
        {items.map(([title, text], index) => <ServiceCard {title} {text} {index} />)}
      </div>
      <div class="surface mt-10 p-7">
        <p class="eyebrow">Observability stack</p>
        <h2 class="mt-3 text-2xl font-bold text-white">Metrics, logs and Telegram alerting in one view.</h2>
        <p class="mt-3 max-w-2xl text-slate-400">
          Prometheus, Grafana, Alertmanager, and Loki provide real-time visibility across stream ingest, GPU transcode load, ZFS/XFS array health, and 3-2-1 backup status.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          {['Prometheus', 'Grafana', 'Alertmanager', 'Loki', 'Telegram Alerts', 'Cloudflare', 'Tailscale'].map((x) => <span class="tag">{x}</span>)}
        </div>
      </div>
    </div>
  </section>
  <CTA title="Improve your operational visibility." />
</BaseLayout>
