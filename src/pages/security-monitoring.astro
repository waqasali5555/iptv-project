---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import ServiceCard from '../components/ServiceCard.astro'; import CTA from '../components/CTA.astro';
const items=[['Linux server hardening','Reduce avoidable exposure with secure access, sensible defaults and routine patching.'],['Firewall & access control','Control service exposure and administrator access with clear network boundaries.'],['SSL/TLS & API security','Protect data in transit and review API-facing services for safer operation.'],['Monitoring & alerting','Turn server, stream and backup signals into timely, actionable notifications.'],['Log management','Collect and inspect logs to support faster diagnosis and operational awareness.'],['DDoS & edge protection','Apply Cloudflare and appropriate layered protections for the service profile.']];
---
<BaseLayout title="IPTV & OTT Security and Monitoring | DevOps Support" description="Linux hardening, firewall configuration, SSL/TLS, Cloudflare, monitoring, alerting and stream health monitoring for IPTV and OTT platforms."><PageHero eyebrow="Security & Monitoring" title="Know what your infrastructure is doing." text="Security controls and observability that help protect authorized streaming operations—and make problems easier to spot."/><section class="section"><div class="shell"><div class="grid-cards">{items.map(([title,text],index)=><ServiceCard {title} {text} {index}/>)}</div><div class="surface mt-10 p-7"><p class="eyebrow">Observability stack</p><h2 class="mt-3 text-2xl font-bold text-white">Metrics, logs and alerting in one operational view.</h2><p class="mt-3 max-w-2xl text-slate-400">Prometheus, Grafana, Alertmanager and Loki can provide useful visibility across server health, service behavior, backup status and stream health.</p><div class="mt-5 flex flex-wrap gap-2">{['Prometheus','Grafana','Alertmanager','Loki','Cloudflare'].map(x=><span class="tag">{x}</span>)}</div></div></div></section><CTA title="Improve your operational visibility." /></BaseLayout>
