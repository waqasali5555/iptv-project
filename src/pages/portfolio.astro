---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';
import { CMS_CATEGORIES, fetchPublishedPortfolioItems } from '../lib/cms';

const { items } = await fetchPublishedPortfolioItems();
const categories = ['All', ...CMS_CATEGORIES] as const;
---
<BaseLayout
  title={`Portfolio | ${site.name} — IPTV, Plex, Unraid & NAS Case Studies`}
  description="Browse verified PlexTech engineering deployments across IPTV & OTT streaming pipelines, Plex 4K GPU & CGNAT fixes, Unraid/TrueNAS/Synology migrations, and Grafana monitoring."
>
  <PageHero
    eyebrow="Portfolio"
    title="Production builds, migrations & remote fixes."
    text="Verified engineering outcomes across authorized IPTV/OTT platforms, private Plex servers, Unraid/TrueNAS/Synology storage, and DevOps observability."
  />

  <section class="section">
    <div class="shell">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filter portfolio by category">
          {
            categories.map((category, index) => (
              <button
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                data-portfolio-tab={category}
                class:list={[
                  'portfolio-tab cursor-pointer rounded-full border px-4 py-2 text-xs font-bold tracking-wide transition',
                  index === 0
                    ? 'border-primary bg-primary text-ink shadow-md shadow-primary/20'
                    : 'border-border bg-card text-muted hover:border-primary/60 hover:text-foreground',
                ]}
              >
                {category}
              </button>
            ))
          }
        </div>
        <p class="text-sm text-muted">
          <span id="portfolio-count">{items.length}</span> project{items.length === 1 ? '' : 's'} shown
        </p>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2" id="portfolio-grid">
        {
          items.map((item) => (
            <article
              class="portfolio-card card flex flex-col justify-between gap-5 p-6"
              data-category={item.category}
            >
              <div>
                {
                  item.image_url ? (
                    <button
                      type="button"
                      class="group relative mb-5 block w-full cursor-pointer overflow-hidden rounded-xl border border-border bg-background text-left"
                      data-lightbox-open
                      data-lightbox-src={item.image_url}
                      data-lightbox-title={item.title}
                      data-lightbox-meta={`${item.category} • ${item.outcome_metric}`}
                      aria-label={`Preview screenshot for ${item.title}`}
                    >
                      <img
                        src={item.image_url}
                        alt={item.title}
                        loading="lazy"
                        class="aspect-video w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                      />
                      <span class="absolute right-3 bottom-3 rounded-full border border-border bg-background/90 px-3 py-1 text-[0.7rem] font-bold text-primary backdrop-blur-sm">
                        Preview Screenshot ↗
                      </span>
                    </button>
                  ) : (
                    <div class="mb-5 flex items-center justify-between rounded-xl border border-border bg-secondary-bg/80 px-4 py-3 text-xs">
                      <span class="font-semibold text-slate-300">{item.client_type}</span>
                      <span class="text-primary font-bold">Architecture Case</span>
                    </div>
                  )
                }

                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="tag">{item.category}</span>
                  <span class="rounded-full border border-success/35 bg-success/10 px-3 py-1 text-xs font-bold text-green-300">
                    {item.outcome_metric}
                  </span>
                </div>

                <h2 class="mt-4 text-xl font-bold text-foreground">{item.title}</h2>
                {item.image_url && <p class="mt-1 text-xs font-semibold text-muted-dark">{item.client_type}</p>}
                <p class="mt-2.5 text-sm leading-relaxed text-muted">{item.summary}</p>
              </div>

              <div class="grid gap-4 border-t border-border/70 pt-4">
                <div class="flex flex-wrap gap-1.5">
                  {item.tech_stack.map((tech) => (
                    <span class="rounded-md border border-border bg-secondary-bg px-2.5 py-1 text-xs font-semibold text-slate-300">
                      {tech}
                    </span>
                  ))}
                </div>

                <button
                  type="button"
                  class="inline-flex w-full cursor-pointer items-center justify-between rounded-xl border border-primary/40 bg-primary/10 px-4 py-2.5 text-xs font-bold text-primary transition hover:border-primary hover:bg-primary hover:text-ink"
                  data-open-consultation
                  data-issue={`Similar build to: ${item.title}`}
                  data-category={item.category}
                  data-details={`Interested in a similar setup or fix (${item.outcome_metric}): ${item.title}`}
                >
                  <span>Need a similar deployment? Request Remote Fix</span>
                  <span aria-hidden="true">↗</span>
                </button>
              </div>
            </article>
          ))
        }
      </div>

      <p id="portfolio-empty" class="mt-8 hidden rounded-xl border border-border bg-card p-6 text-center text-sm text-muted">
        No published portfolio items in this category yet.
      </p>
    </div>
  </section>

  <CTA
    title="Want results like these on your server or NAS?"
    text="Book a remote engineering session over SSH, RustDesk, or AnyDesk."
  />

  <div
    id="portfolio-lightbox"
    class="fixed inset-0 z-80 hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="lightbox-title"
    hidden
  >
    <div class="fixed inset-0 bg-[#020617]/88 backdrop-blur-sm" data-lightbox-close></div>
    <div class="relative z-10 w-full max-w-4xl overflow-hidden rounded-2xl border border-border bg-card shadow-2xl">
      <div class="flex items-center justify-between gap-4 border-b border-border bg-card-elevated px-5 py-4">
        <div>
          <p id="lightbox-meta" class="text-xs font-bold tracking-wider text-primary uppercase"></p>
          <h3 id="lightbox-title" class="mt-1 text-base font-bold text-foreground"></h3>
        </div>
        <button
          type="button"
          data-lightbox-close
          class="grid size-9 shrink-0 cursor-pointer place-items-center rounded-lg border border-border text-lg text-muted hover:border-primary hover:text-foreground"
          aria-label="Close image preview"
        >
          ×
        </button>
      </div>
      <div class="bg-[#040a14] p-3">
        <img id="lightbox-img" src="" alt="" class="max-h-[75vh] w-full rounded-lg object-contain" />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';
  import type { PortfolioItem } from '../lib/cms';

  const grid = document.getElementById('portfolio-grid');
  const countEl = document.getElementById('portfolio-count');
  const emptyEl = document.getElementById('portfolio-empty');
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-portfolio-tab]'));

  const lightbox = document.getElementById('portfolio-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxMeta = document.getElementById('lightbox-meta');

  let activeCategory = 'All';

  const activeClasses = ['border-primary', 'bg-primary', 'text-ink', 'shadow-md', 'shadow-primary/20'];
  const inactiveClasses = ['border-border', 'bg-card', 'text-muted', 'hover:border-primary/60', 'hover:text-foreground'];

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch] || ch);

  const applyFilter = () => {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.portfolio-card'));
    let visible = 0;
    cards.forEach((card) => {
      const show = activeCategory === 'All' || card.dataset.category === activeCategory;
      card.hidden = !show;
      if (show) {
        card.classList.add('revealed');
        visible++;
      }
    });
    if (countEl) countEl.textContent = String(visible);
    if (emptyEl) emptyEl.classList.toggle('hidden', visible > 0);
  };

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.portfolioTab || 'All';
      tabButtons.forEach((b) => {
        const current = b === btn;
        b.setAttribute('aria-selected', String(current));
        b.classList.remove(...(current ? inactiveClasses : activeClasses));
        b.classList.add(...(current ? activeClasses : inactiveClasses));
      });
      applyFilter();
    });
  });

  const openLightbox = (src: string, title: string, meta: string) => {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = src;
    lightboxImg.alt = title;
    if (lightboxTitle) lightboxTitle.textContent = title;
    if (lightboxMeta) lightboxMeta.textContent = meta;
    lightbox.hidden = false;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    if (!lightbox || lightbox.hidden) return;
    lightbox.hidden = true;
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    if (lightboxImg) lightboxImg.src = '';
    document.body.style.overflow = '';
  };

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;
    const opener = target.closest<HTMLElement>('[data-lightbox-open]');
    if (opener?.dataset.lightboxSrc) {
      openLightbox(
        opener.dataset.lightboxSrc,
        opener.dataset.lightboxTitle || 'Portfolio screenshot',
        opener.dataset.lightboxMeta || '',
      );
      return;
    }
    if (target.closest('[data-lightbox-close]')) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && lightbox && !lightbox.hidden) {
      closeLightbox();
    }
  });

  const renderPortfolioCard = (item: PortfolioItem) => {
    const safeTitle = escapeHtml(item.title);
    const safeCategory = escapeHtml(item.category);
    const safeClient = escapeHtml(item.client_type);
    const safeMetric = escapeHtml(item.outcome_metric);
    const safeSummary = escapeHtml(item.summary);
    const safeImage = item.image_url ? escapeHtml(item.image_url) : '';
    const stackHtml = (item.tech_stack || [])
      .map(
        (tech) =>
          `<span class="rounded-md border border-border bg-secondary-bg px-2.5 py-1 text-xs font-semibold text-slate-300">${escapeHtml(tech)}</span>`,
      )
      .join('');

    const mediaBlock = safeImage
      ? `<button type="button" class="group relative mb-5 block w-full cursor-pointer overflow-hidden rounded-xl border border-border bg-background text-left" data-lightbox-open data-lightbox-src="${safeImage}" data-lightbox-title="${safeTitle}" data-lightbox-meta="${safeCategory} • ${safeMetric}" aria-label="Preview screenshot for ${safeTitle}">
           <img src="${safeImage}" alt="${safeTitle}" loading="lazy" class="aspect-video w-full object-cover transition duration-300 group-hover:scale-[1.02]" />
           <span class="absolute right-3 bottom-3 rounded-full border border-border bg-background/90 px-3 py-1 text-[0.7rem] font-bold text-primary backdrop-blur-sm">Preview Screenshot ↗</span>
         </button>`
      : `<div class="mb-5 flex items-center justify-between rounded-xl border border-border bg-secondary-bg/80 px-4 py-3 text-xs">
           <span class="font-semibold text-slate-300">${safeClient}</span>
           <span class="font-bold text-primary">Architecture Case</span>
         </div>`;

    return `
      <article class="portfolio-card card revealed flex flex-col justify-between gap-5 p-6" data-category="${safeCategory}">
        <div>
          ${mediaBlock}
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="tag">${safeCategory}</span>
            <span class="rounded-full border border-success/35 bg-success/10 px-3 py-1 text-xs font-bold text-green-300">${safeMetric}</span>
          </div>
          <h2 class="mt-4 text-xl font-bold text-foreground">${safeTitle}</h2>
          ${safeImage ? `<p class="mt-1 text-xs font-semibold text-muted-dark">${safeClient}</p>` : ''}
          <p class="mt-2.5 text-sm leading-relaxed text-muted">${safeSummary}</p>
        </div>
        <div class="grid gap-4 border-t border-border/70 pt-4">
          <div class="flex flex-wrap gap-1.5">${stackHtml}</div>
          <button type="button" class="inline-flex w-full cursor-pointer items-center justify-between rounded-xl border border-primary/40 bg-primary/10 px-4 py-2.5 text-xs font-bold text-primary transition hover:border-primary hover:bg-primary hover:text-ink" data-open-consultation data-issue="Similar build to: ${safeTitle}" data-category="${safeCategory}" data-details="Interested in a similar setup or fix (${safeMetric}): ${safeTitle}">
            <span>Need a similar deployment? Request Remote Fix</span>
            <span aria-hidden="true">↗</span>
          </button>
        </div>
      </article>
    `;
  };

  const syncLivePortfolio = async () => {
    if (!grid) return;
    const { data, error } = await supabase
      .from('portfolio_items')
      .select('*')
      .eq('published', true)
      .order('created_at', { ascending: false });

    if (!error && Array.isArray(data) && data.length > 0) {
      grid.innerHTML = (data as PortfolioItem[]).map(renderPortfolioCard).join('');
      applyFilter();
    }
  };

  void syncLivePortfolio();
</script>
