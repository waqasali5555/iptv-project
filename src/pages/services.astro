---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import ServiceCard from '../components/ServiceCard.astro'; import CTA from '../components/CTA.astro'; import { services } from '../data/site';
---
<BaseLayout title="IPTV & OTT Infrastructure Services | Server & DevOps Support" description="Professional server setup, streaming deployment, optimization, monitoring and managed technical support for licensed IPTV and OTT businesses."><PageHero eyebrow="Services" title="Technical services for resilient streaming operations." text="Focused infrastructure, deployment and operational support for authorized IPTV and OTT businesses." /><section class="section"><div class="shell"><h2 class="sr-only">IPTV and OTT infrastructure service catalogue</h2><div class="grid-cards">{services.map(([title,text],index)=><ServiceCard {title} {text} {index}/>)}</div></div></section><CTA title="Need an infrastructure plan?" text="Discuss a deployment, migration, operational challenge or streaming issue with a technical specialist." /></BaseLayout>
