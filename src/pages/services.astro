---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTA from '../components/CTA.astro';
import { services, site } from '../data/site';
---
<BaseLayout
  title={`Services | ${site.name} — IPTV, OTT, Plex, Unraid & NAS Infrastructure`}
  description="Professional IPTV & OTT streaming deployment, Plex 4K GPU optimization & CGNAT fixes, Unraid/TrueNAS/Synology NAS migrations, and DevOps monitoring support."
>
  <PageHero
    eyebrow="Services"
    title="Technical services for resilient streaming, Plex & NAS operations."
    text={site.disclaimer}
  />
  <section class="section">
    <div class="shell">
      <h2 class="sr-only">PlexTech infrastructure service catalogue</h2>
      <div class="grid-cards">
        {services.map(([title, text], index) => <ServiceCard {title} {text} {index} />)}
      </div>
    </div>
  </section>
  <CTA
    title="Need an infrastructure or migration plan?"
    text="Discuss an IPTV/OTT deployment, Plex CGNAT fix, NAS migration, or monitoring stack with a specialist."
  />
</BaseLayout>
