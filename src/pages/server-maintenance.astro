---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';

const tasks = [
  'Server & NAS health checks',
  'Security & kernel updates',
  'FFmpeg & TCP BBR tuning',
  'GPU & resource monitoring',
  '3-2-1 backup verification',
  'Grafana & Loki log monitoring',
  'Docker & UID/GID maintenance',
  'Nginx & WireGuard maintenance',
  'SSL certificate checks',
  'Stream & EPG health checks',
  'Priority incident response',
];
---
<BaseLayout
  title={`Managed Maintenance | ${site.name} — Retainers for IPTV, Plex & NAS`}
  description="Monthly managed server and NAS maintenance retainers for IPTV/OTT platforms, Plex Media Servers, Unraid, TrueNAS, and Synology infrastructure."
>
  <PageHero
    eyebrow="Managed Maintenance"
    title="Keep your streaming and NAS systems ready."
    text="Monthly infrastructure retainers covering proactive monitoring, updates, backup verification, and priority remote incident response."
  />
  <section class="section">
    <div class="shell">
      <h2 class="sr-only">Included managed maintenance services</h2>
      <div class="grid-cards">
        {
          tasks.map((task, i) => (
            <article class="card">
              <div class="flex items-center justify-between">
                <span class="text-2xl font-bold text-cyan">{String(i + 1).padStart(2, '0')}</span>
                <span class="tag">Retainer</span>
              </div>
              <h3>{task}</h3>
              <p>Scheduled technical oversight that prevents silent failures and keeps workloads predictable.</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <CTA title="Get a monthly infrastructure retainer." action="Discuss Retainer Plans" />
</BaseLayout>
