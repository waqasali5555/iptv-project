---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import CTA from '../components/CTA.astro';
const tasks=['Server health checks','Security updates','Performance optimization','Resource monitoring','Backup verification','Log monitoring','Docker maintenance','Nginx maintenance','SSL certificate checks','Streaming health checks','Incident troubleshooting'];
---
<BaseLayout title="Managed Server Maintenance | IPTV & OTT Infrastructure" description="Ongoing managed server maintenance for IPTV and OTT infrastructure, including monitoring, updates, backups, SSL checks, Docker and Nginx maintenance."><PageHero eyebrow="Managed Maintenance" title="Keep your streaming systems ready." text="A recurring maintenance service for the routine checks and technical care that production infrastructure needs."/><section class="section"><div class="shell"><h2 class="sr-only">Included managed maintenance services</h2><div class="grid-cards">{tasks.map((task,i)=><article class="card"><div class="flex items-center justify-between"><span class="text-2xl font-bold text-cyan">{String(i+1).padStart(2,'0')}</span><span class="tag">Included</span></div><h3>{task}</h3><p>Regular technical attention that supports a healthier, more predictable operating environment.</p></article>)}</div></div></section><CTA title="Get managed server support." action="Get Managed Server Support"/></BaseLayout>
