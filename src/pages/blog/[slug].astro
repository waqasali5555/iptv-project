---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { fetchPublishedBlogPosts, formatDisplayDate, type BlogPost } from '../../lib/cms';
import { renderMarkdown } from '../../lib/markdown';

export async function getStaticPaths() {
  const { posts } = await fetchPublishedBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const pageTitle = post.meta_title?.trim() || `${post.title} | ${site.name}`;
const pageDescription = post.meta_description?.trim() || post.excerpt;
const renderedHtml = renderMarkdown(post.content);
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  article={{
    headline: post.title,
    description: pageDescription,
    publishedTime: post.created_at,
    modifiedTime: post.updated_at,
    image: post.cover_image_url,
    section: post.category,
  }}
>
  <article class="section" data-blog-slug={post.slug}>
    <div class="shell max-w-4xl">
      <a href="/blog/" class="inline-flex items-center gap-2 text-xs font-bold tracking-wider text-primary uppercase hover:text-foreground">
        ← Back to Engineering Blog
      </a>

      <header class="mt-6 border-b border-border pb-8">
        <div class="flex flex-wrap items-center gap-3">
          <span id="post-category" class="tag">{post.category}</span>
          <time id="post-date" datetime={post.created_at} class="text-xs font-semibold text-muted-dark">
            Published {formatDisplayDate(post.created_at)}
          </time>
        </div>

        <h1 id="post-title" class="mt-4 text-3xl font-extrabold tracking-tight text-foreground md:text-5xl">
          {post.title}
        </h1>
        <p id="post-excerpt" class="lede mt-4">{post.excerpt}</p>

        {
          post.cover_image_url && (
            <div class="mt-8 overflow-hidden rounded-2xl border border-border bg-card">
              <img
                id="post-cover"
                src={post.cover_image_url}
                alt={post.title}
                class="max-h-[460px] w-full object-cover"
              />
            </div>
          )
        }
      </header>

      <div id="post-content" class="prose mt-10 max-w-none" set:html={renderedHtml} />

      <div class="cta-panel relative mt-14 overflow-hidden rounded-2xl border border-border p-7 md:p-10">
        <div class="orb -right-16 -top-16 size-56 bg-primary/10"></div>
        <p class="eyebrow">Remote Engineering • {site.domain}</p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight md:text-3xl">
          Need help with this issue? Book a Remote Fix
        </h2>
        <p class="mt-2.5 max-w-2xl text-sm text-muted">
          Get hands-on troubleshooting via SSH, RustDesk, or AnyDesk for your IPTV/OTT pipeline, Plex server, or NAS array.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <button
            type="button"
            id="post-book-btn"
            data-open-consultation
            data-issue={post.title}
            data-category={post.category}
            data-details={`Reading "${post.title}" and need remote assistance with this issue.`}
            class="btn btn-primary cursor-pointer"
          >
            Need help with this issue? Book a Remote Fix ↗
          </button>
          <a class="btn btn-secondary" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
            WhatsApp {site.phone}
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import { formatDisplayDate, type BlogPost } from '../../lib/cms';
  import { renderMarkdown } from '../../lib/markdown';

  const articleEl = document.querySelector<HTMLElement>('[data-blog-slug]');
  const slug = articleEl?.dataset.blogSlug;

  const refreshPost = async () => {
    if (!slug) return;
    const { data, error } = await supabase
      .from('blog_posts')
      .select('*')
      .eq('slug', slug)
      .eq('published', true)
      .maybeSingle();

    if (error || !data) return;
    const post = data as BlogPost;

    const titleEl = document.getElementById('post-title');
    const excerptEl = document.getElementById('post-excerpt');
    const categoryEl = document.getElementById('post-category');
    const dateEl = document.getElementById('post-date');
    const contentEl = document.getElementById('post-content');
    const bookBtn = document.getElementById('post-book-btn');

    if (titleEl) titleEl.textContent = post.title;
    if (excerptEl) excerptEl.textContent = post.excerpt;
    if (categoryEl) categoryEl.textContent = post.category;
    if (dateEl) dateEl.textContent = `Published ${formatDisplayDate(post.created_at)}`;
    if (contentEl) contentEl.innerHTML = renderMarkdown(post.content);
    if (bookBtn instanceof HTMLElement) {
      bookBtn.dataset.issue = post.title;
      bookBtn.dataset.category = post.category;
      bookBtn.dataset.details = `Reading "${post.title}" and need remote assistance with this issue.`;
    }
    document.title = post.meta_title?.trim() || `${post.title} | PlexTech`;
  };

  void refreshPost();
</script>
