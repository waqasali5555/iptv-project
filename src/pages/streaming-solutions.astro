---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';

const protocols = ['HLS', 'MPEG-DASH', 'RTMP', 'RTSP', 'SRT', 'WebRTC'];
const tools = [
  'FFmpeg',
  'Nginx',
  'Nginx RTMP',
  'SRS',
  'MediaMTX',
  'Wowza',
  'Ant Media Server',
  'Flussonic',
  'Nimble Streamer',
  'GStreamer',
];
---
<BaseLayout
  title={`Streaming Solutions | ${site.name} — HLS, DASH, RTMP, SRT & Plex`}
  description="Streaming server deployment and technical support for SRT/RTMP ingest, FFmpeg ABR transcoding, HLS, MPEG-DASH, CDN delivery, and M3U/EPG integration."
>
  <PageHero
    eyebrow="Streaming Solutions"
    title="From ingest to delivery, designed for the real world."
    text="Streaming workflows for authorized platforms and media servers: stable SRT/RTMP ingest, GPU-accelerated transcoding, CDN delivery, and full observability."
  />
  <section class="section">
    <div class="shell grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Protocols</p>
        <h2 class="section-title">Choose the right delivery path.</h2>
        <p class="lede">
          We design, deploy, and troubleshoot protocol stacks around latency targets, ABR device compatibility, and peak viewer concurrency.
        </p>
        <div class="mt-7 flex flex-wrap gap-2">
          {protocols.map((p) => <span class="tag px-3 py-2">{p}</span>)}
        </div>
      </div>
      <div class="surface p-6">
        <h2 class="text-xl font-bold text-white">Streaming services</h2>
        <ul class="mt-4 grid gap-3 pl-5 text-sm text-slate-300 marker:text-cyan">
          <li>FFmpeg ABR encoding &amp; GPU hardware transcoding (QuickSync, NVENC, AMD VCN)</li>
          <li>SRT / RTMP stream ingest, relay, and worker load balancing</li>
          <li>HLS / MPEG-DASH packaging, TCP BBR tuning &amp; CDN edge caching</li>
          <li>M3U playlist &amp; XMLTV EPG cron automation with timezone alignment</li>
          <li>Resilient configurations strictly for authorized and licensed media</li>
        </ul>
      </div>
    </div>
  </section>
  <section class="border-y border-[#1d3954] bg-[#091727]">
    <div class="shell section">
      <p class="eyebrow">Technology stack</p>
      <h2 class="section-title">Tools we deploy and troubleshoot.</h2>
      <div class="mt-7 grid-cards">
        {
          tools.map((tool, i) => (
            <article class="card">
              <div class="icon-box">{i + 1}</div>
              <h3>{tool}</h3>
              <p>Deployment, integration, configuration and technical troubleshooting.</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <CTA title="Plan a dependable streaming workflow." />
</BaseLayout>
