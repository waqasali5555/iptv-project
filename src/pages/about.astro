---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';

const specialties = [
  'IPTV / OTT Streaming',
  'SRT / RTMP / HLS / DASH',
  'Plex & GPU Transcoding',
  'CGNAT / WireGuard / Tailscale',
  'Unraid / TrueNAS / Synology',
  'ZFS / XFS / 3-2-1 Backups',
  'Docker & Kubernetes',
  'Prometheus & Grafana',
  'Linux & Terraform',
  'Cloudflare & Nginx',
];
---
<BaseLayout
  title={`About | ${site.name} — ${site.subtitle}`}
  description="PlexTech DevOps and cloud infrastructure engineering focused on authorized IPTV/OTT streaming systems, Plex optimization, Unraid/TrueNAS/Synology NAS, and observability."
>
  <PageHero
    eyebrow="About PlexTech"
    title="DevOps, Streaming & Storage Infrastructure Engineer"
    text={`Technical infrastructure support at ${site.domain} for teams operating authorized IPTV/OTT platforms, private Plex media servers, and SMB storage clusters.`}
  />
  <section class="section">
    <div class="shell grid gap-10 lg:grid-cols-[1fr_.9fr]">
      <div class="prose">
        <h2>A focused technical practice.</h2>
        <p>
          PlexTech focuses on the practical systems behind reliable media and cloud operations: SRT/RTMP ingest,
          FFmpeg ABR transcoding, CDN delivery, Plex hardware GPU acceleration, CGNAT/Double NAT remote access,
          Unraid/TrueNAS/Synology storage engineering, and 24/7 Prometheus/Grafana observability.
        </p>
        <p>
          The goal is straightforward: build production-ready environments that are easier to operate, diagnose,
          back up, and scale over time.
        </p>
        <p>{site.disclaimer}</p>
      </div>
      <div class="surface p-7">
        <p class="eyebrow">Specialized in</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {specialties.map((x) => <span class="tag px-3 py-2">{x}</span>)}
        </div>
      </div>
    </div>
  </section>
  <CTA title="Let’s talk through your infrastructure." />
</BaseLayout>
