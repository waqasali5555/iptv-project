---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';

const problems = [
  'IPTV buffering & stream freezing',
  'M3U playlist & EPG XMLTV sync errors',
  'SRT / RTMP ingest & transcode drops',
  'Plex Remote Access & CGNAT / Double NAT',
  '4K GPU passthrough (QuickSync / NVENC / VCN)',
  'Unraid / TrueNAS / Synology migrations',
  'Docker UID/GID permission conflicts',
  'High CPU / RAM & TCP BBR network tuning',
  'Nginx, Cloudflare CDN & SSL issues',
  'Firewall, WireGuard & Tailscale routing',
  'ZFS / XFS pool & 3-2-1 backup failures',
  'Grafana, Prometheus & Telegram alert setup',
];
---
<BaseLayout
  title={`Troubleshooting | ${site.name} — IPTV, Plex, Unraid & NAS Support`}
  description="Remote troubleshooting for IPTV buffering, M3U/EPG errors, SRT/RTMP drops, Plex CGNAT & 4K GPU transcoding, and Unraid/TrueNAS/Synology NAS issues."
>
  <PageHero
    eyebrow="Technical Support"
    title="IPTV, Plex & NAS Troubleshooting"
    text="When playback, remote access, storage pools, or streaming pipelines break down, get a structured remote diagnosis instead of guesswork."
  />
  <section class="section">
    <div class="shell grid gap-10 lg:grid-cols-[.9fr_1.1fr]">
      <div>
        <p class="eyebrow">Diagnose. Resolve. Prevent.</p>
        <h2 class="section-title">Clear investigation across the full stack.</h2>
        <p class="lede">
          We trace issues across ingest, transcoding, CDN edge caching, Docker containers, ZFS/XFS storage, and CGNAT networking—then apply a clean, documented fix.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
            WhatsApp {site.phone} ↗
          </a>
          <button
            type="button"
            data-open-consultation
            data-issue="Infrastructure Troubleshooting Request"
            class="btn btn-secondary cursor-pointer"
          >
            Request Remote Fix
          </button>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          problems.map((problem, i) => (
            <div class="flex items-center gap-3 rounded-lg border border-[#1d3954] bg-[#0b1b2d] p-4 text-sm font-semibold text-slate-200">
              <span class="text-cyan">{String(i + 1).padStart(2, '0')}</span>
              {problem}
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <CTA title="Get remote engineering support for your issue." action="Chat on WhatsApp" />
</BaseLayout>
