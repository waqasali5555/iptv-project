---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import CTA from '../components/CTA.astro';
const problems=['Streaming interruptions','Buffering & freezing','Server overload','High CPU / RAM usage','Network & DNS problems','Firewall & SSL issues','M3U & EPG problems','IPTV panel issues','FFmpeg & transcoding errors','CDN & Nginx issues','Docker & database issues','API & performance issues','Server downtime'];
---
<BaseLayout title="IPTV & OTT Troubleshooting | Technical Support" description="Expert IPTV and OTT troubleshooting for buffering, server overload, M3U, EPG, FFmpeg, Nginx, Docker, CDN, network and performance issues."><PageHero eyebrow="Technical Support" title="IPTV & OTT Troubleshooting" text="When playback, infrastructure or operations break down, get a structured diagnosis instead of more guesswork."/><section class="section"><div class="shell grid gap-10 lg:grid-cols-[.9fr_1.1fr]"><div><p class="eyebrow">Diagnose. Resolve. Prevent.</p><h2 class="section-title">Clear investigation across the full stack.</h2><p class="lede">We trace issues across application, streaming, server, networking and delivery layers, then prioritize a stable and maintainable fix.</p><a class="btn btn-primary mt-7" href="https://wa.me/923057270179" target="_blank" rel="noopener noreferrer">Need Help With an IPTV / OTT Issue? ↗</a></div><div class="grid grid-cols-1 gap-3 sm:grid-cols-2">{problems.map((problem,i)=><div class="flex items-center gap-3 rounded-lg border border-[#1d3954] bg-[#0b1b2d] p-4 text-sm font-semibold text-slate-200"><span class="text-cyan">{String(i+1).padStart(2,'0')}</span>{problem}</div>)}</div></div></section><CTA title="Get technical support for your streaming issue." action="Chat on WhatsApp"/></BaseLayout>
