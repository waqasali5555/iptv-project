---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CommonIssuesSection from '../components/CommonIssuesSection.astro';
import CaseStudiesSection from '../components/CaseStudiesSection.astro';
import FaqSection from '../components/FaqSection.astro';
import CTA from '../components/CTA.astro';
import { services, site, faqItems } from '../data/site';

const title = 'PlexTech | IPTV, OTT, Plex, Unraid & NAS Infrastructure Services';
const description =
  'PlexTech (plextech.online) provides IPTV & OTT streaming infrastructure (SRT/RTMP, FFmpeg ABR, HLS/DASH, CDN, M3U/EPG), Plex Media Server 4K GPU transcoding & CGNAT fixes, Unraid/TrueNAS/Synology NAS migrations, and Docker/Kubernetes/Grafana DevOps support.';
---
<BaseLayout {title} {description} {faqItems}>
  <section class="grid-bg relative isolate overflow-hidden">
    <div class="orb -left-40 top-10 size-96 bg-blue/20"></div>
    <div class="orb right-0 top-20 size-72 bg-cyan/10"></div>

    <div class="shell grid min-h-[660px] items-center gap-12 py-20 lg:grid-cols-[1.1fr_.9fr]">
      <div>
        <p class="eyebrow reveal">PlexTech • {site.subtitle} • {site.domain}</p>
        <h1 class="display mt-5 reveal">
          IPTV, OTT, Plex &amp;<br />
          <span class="text-cyan">NAS Infrastructure</span> Engineering
        </h1>
        <p class="mt-4 text-xl font-medium text-white/85">{site.tagline}</p>
        <p class="lede mt-5">
          Production-grade engineering for <strong>IPTV &amp; OTT streaming</strong> (SRT/RTMP ingest, FFmpeg/ABR
          transcoding, HLS/DASH, CDN, M3U &amp; EPG), <strong>Plex Media Server</strong> optimization (4K GPU
          transcoding, CGNAT/Double NAT remote access), <strong>Unraid / TrueNAS / Synology NAS</strong>
          (migrations, Docker UID/GID permissions, ZFS/XFS, 3-2-1 backups), and <strong>DevOps monitoring</strong>
          (Docker, Kubernetes, Tailscale, Grafana &amp; Prometheus).
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <button type="button" data-open-consultation class="btn btn-primary cursor-pointer">
            Get a Free Consultation ↗
          </button>
          <a
            class="btn btn-secondary"
            href={site.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp {site.phone} ↗
          </a>
        </div>

        <p class="mt-7 text-xs text-slate-400">
          {site.disclaimer}
        </p>
      </div>

      <div class="float relative mx-auto w-full max-w-lg" aria-label="Illustrated streaming and NAS infrastructure diagram">
        <div class="surface relative min-h-90 overflow-hidden p-5 shadow-2xl shadow-black/40">
          <div class="mb-5 flex items-center justify-between border-b border-[#1d3954] pb-4">
            <span class="text-xs font-bold tracking-[.15em] text-slate-300">INFRASTRUCTURE TELEMETRY</span>
            <span class="tag">● HEALTHY</span>
          </div>

          <div class="grid grid-cols-3 gap-3 text-center text-[.68rem] font-bold text-slate-200">
            <div class="rounded-lg border border-cyan/40 bg-cyan/10 p-3">
              INGEST<br /><span class="text-cyan">SRT / RTMP</span>
            </div>
            <div class="rounded-lg border border-blue/40 bg-blue/10 p-3">
              TRANSCODE<br /><span class="text-blue-300">NVENC / QSV</span>
            </div>
            <div class="rounded-lg border border-cyan/40 bg-cyan/10 p-3">
              DELIVER<br /><span class="text-cyan">HLS / PLEX / CDN</span>
            </div>
          </div>

          <svg viewBox="0 0 460 150" class="my-2 w-full" aria-hidden="true">
            <path
              d="M75 15V68H230V122M230 68H385V15"
              fill="none"
              stroke="#38d9f5"
              stroke-width="2"
              stroke-dasharray="5 7"
              opacity=".7"
            />
            <circle cx="75" cy="15" r="7" fill="#38d9f5" />
            <circle cx="385" cy="15" r="7" fill="#3b82f6" />
            <circle cx="230" cy="122" r="7" fill="#38d9f5" />
          </svg>

          <div class="grid grid-cols-3 gap-3">
            <div class="rounded-lg border border-[#1d3954] bg-[#081522] p-3">
              <p class="m-0 text-[.65rem] text-slate-400">STREAM HEALTH</p>
              <p class="m-0 mt-1 text-lg font-bold text-white">99.9<span class="text-xs text-cyan">%</span></p>
            </div>
            <div class="rounded-lg border border-[#1d3954] bg-[#081522] p-3">
              <p class="m-0 text-[.65rem] text-slate-400">PLEX / GPU</p>
              <p class="m-0 mt-1 text-lg font-bold text-white">4K<span class="text-xs text-cyan"> HW</span></p>
            </div>
            <div class="rounded-lg border border-[#1d3954] bg-[#081522] p-3">
              <p class="m-0 text-[.65rem] text-slate-400">ZFS / NAS</p>
              <p class="m-0 mt-1 text-lg font-bold text-white">3-2-1<span class="text-xs text-cyan"> OK</span></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeader
        eyebrow="Core Services"
        title="Full-stack infrastructure for streaming, media servers & storage."
        text="Dedicated engineering across IPTV/OTT pipelines, Plex remote access & GPU transcoding, Unraid/TrueNAS/Synology NAS clusters, and DevOps observability."
      />
      <div class="grid-cards mt-10">
        {services.slice(0, 6).map(([title, text], index) => <ServiceCard {title} {text} {index} />)}
      </div>
      <a class="mt-7 inline-flex text-sm font-bold text-cyan hover:text-white" href="/services/">
        Explore all 15 infrastructure services →
      </a>
    </div>
  </section>

  <CommonIssuesSection />

  <CaseStudiesSection />

  <section class="border-y border-[#1d3954] bg-[#091727]">
    <div class="shell grid gap-8 py-12 md:grid-cols-3">
      <div>
        <p class="eyebrow">Operational clarity</p>
        <h2 class="mt-3 text-2xl font-bold text-white">A practical engineering partner for production teams &amp; NAS operators.</h2>
      </div>
      <div class="card">
        <span class="tag">01</span>
        <h3>Production-minded</h3>
        <p>Architecture built for uptime, zero-data-loss storage, clean Docker permissions, and repeatable recovery from day one.</p>
      </div>
      <div class="card">
        <span class="tag">02</span>
        <h3>Remote fixes when it matters</h3>
        <p>Fast root-cause diagnosis across SRT/HLS delivery, Plex CGNAT tunnels, GPU passthrough, and Prometheus/Grafana alerts.</p>
      </div>
    </div>
  </section>

  <FaqSection />

  <CTA />
</BaseLayout>
