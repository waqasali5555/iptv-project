---
import BaseLayout from '../layouts/BaseLayout.astro'; import SectionHeader from '../components/SectionHeader.astro'; import ServiceCard from '../components/ServiceCard.astro'; import CTA from '../components/CTA.astro'; import { services, site } from '../data/site';
const title='IPTV & OTT Infrastructure Services | Streaming & DevOps'; const description='Professional IPTV and OTT infrastructure services including server deployment, streaming setup, M3U and EPG integration, monitoring, security, optimization and technical support.';
---
<BaseLayout {title} {description}><section class="grid-bg relative isolate overflow-hidden"><div class="orb -left-40 top-10 size-96 bg-blue/20"></div><div class="orb right-0 top-20 size-72 bg-cyan/10"></div><div class="shell grid min-h-[650px] items-center gap-12 py-20 lg:grid-cols-[1.08fr_.92fr]"><div><p class="eyebrow reveal">Global IPTV & OTT Infrastructure Support</p><h1 class="display mt-5 reveal">IPTV & OTT<br /><span class="text-cyan">Infrastructure</span> Services</h1><p class="mt-4 text-xl font-medium text-white/80">Build • Secure • Monitor • Optimize</p><p class="lede mt-5">Production-ready infrastructure, streaming deployment, troubleshooting and managed technical support for IPTV and OTT businesses worldwide.</p><div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-primary" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Get a Free Consultation ↗</a><a class="btn btn-secondary" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a></div><p class="mt-7 text-xs text-slate-500">For authorized and licensed IPTV/OTT content and streaming platforms.</p></div><div class="float relative mx-auto w-full max-w-lg" aria-label="Illustrated streaming infrastructure diagram"><div class="surface relative min-h-90 overflow-hidden p-5 shadow-2xl shadow-black/40"><div class="mb-5 flex items-center justify-between border-b border-[#1d3954] pb-4"><span class="text-xs font-bold tracking-[.15em] text-slate-300">NETWORK OVERVIEW</span><span class="tag">● HEALTHY</span></div><div class="grid grid-cols-3 gap-3 text-center text-[.68rem] font-bold text-slate-200"><div class="rounded-lg border border-cyan/40 bg-cyan/10 p-3">INGEST<br /><span class="text-cyan">SRT / RTMP</span></div><div class="rounded-lg border border-blue/40 bg-blue/10 p-3">ENCODE<br /><span class="text-blue-300">ABR</span></div><div class="rounded-lg border border-cyan/40 bg-cyan/10 p-3">DELIVER<br /><span class="text-cyan">CDN</span></div></div><svg viewBox="0 0 460 160" class="my-2 w-full" aria-hidden="true"><path d="M75 15V70H230V125M230 70H385V15" fill="none" stroke="#38d9f5" stroke-width="2" stroke-dasharray="5 7" opacity=".7"/><circle cx="75" cy="15" r="7" fill="#38d9f5"/><circle cx="385" cy="15" r="7" fill="#3b82f6"/><circle cx="230" cy="125" r="7" fill="#38d9f5"/></svg><div class="grid grid-cols-2 gap-3"><div class="rounded-lg border border-[#1d3954] bg-[#081522] p-3"><p class="m-0 text-[.68rem] text-slate-400">SERVER LOAD</p><p class="m-0 mt-1 text-xl font-bold text-white">32<span class="text-sm text-cyan">%</span></p></div><div class="rounded-lg border border-[#1d3954] bg-[#081522] p-3"><p class="m-0 text-[.68rem] text-slate-400">STREAM HEALTH</p><p class="m-0 mt-1 text-xl font-bold text-white">99.9<span class="text-sm text-cyan">%</span></p></div></div></div></div></div></section><section class="section"><div class="shell"><SectionHeader eyebrow="What we do" title="Infrastructure built for reliable streaming." text="From a clean server deployment to ongoing operations, each layer is designed to be observable, maintainable and secure." /><div class="grid-cards mt-10">{services.slice(0,6).map(([title,text],index)=><ServiceCard {title} {text} {index} />)}</div><a class="mt-7 inline-flex text-sm font-bold text-cyan hover:text-white" href="/services/">Explore all services →</a></div></section><section class="border-y border-[#1d3954] bg-[#091727]"><div class="shell grid gap-8 py-12 md:grid-cols-3"><div><p class="eyebrow">Operational clarity</p><h2 class="mt-3 text-2xl font-bold text-white">A practical partner for technical teams.</h2></div><div class="card"><span class="tag">01</span><h3>Production-minded</h3><p>Architecture that considers uptime, capacity, recovery and change management from day one.</p></div><div class="card"><span class="tag">02</span><h3>Support when it matters</h3><p>Structured troubleshooting for complex server, playback, platform and network failures.</p></div></div></section><CTA /></BaseLayout>
