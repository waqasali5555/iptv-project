---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import { site } from '../data/site';
---
<BaseLayout title="Contact | IPTV & OTT Infrastructure Services" description="Contact IPTV & OTT Infrastructure Services for a free consultation, technical support, server deployment or streaming infrastructure audit."><PageHero eyebrow="Contact" title="Start with a technical conversation." text="Tell us what you are building, operating or trying to fix. WhatsApp is the fastest way to reach out."/><section class="section"><div class="shell grid gap-8 lg:grid-cols-[.85fr_1.15fr]"><div class="grid gap-3"><a class="card" href={site.whatsapp} target="_blank" rel="noopener noreferrer"><span class="tag">WhatsApp</span><h3>{site.phone}</h3><p>Chat for a free consultation or technical support request.</p></a><a class="card" href={`mailto:${site.email}`}><span class="tag">Email</span><h3 class="break-all">{site.email}</h3><p>Share project details, existing architecture or an issue summary.</p></a><a class="card" href={site.linkedin} target="_blank" rel="noopener noreferrer"><span class="tag">LinkedIn</span><h3>Professional profile</h3><p>Connect on LinkedIn.</p></a><a class="card" href={site.facebook} target="_blank" rel="noopener noreferrer"><span class="tag">Facebook</span><h3>Facebook profile</h3><p>Connect on Facebook.</p></a></div><form class="surface p-6 md:p-8" action={`mailto:${site.email}`} method="get"><h2 class="text-2xl font-bold text-white">Request a Free Consultation</h2><p class="mt-2 text-sm text-slate-400">This static form opens your email app. For a faster response, use WhatsApp.</p><div class="mt-6 grid gap-4"><label class="grid gap-1 text-sm font-semibold text-slate-200">Name<input required name="subject" class="rounded-md border border-[#31506f] bg-[#07111f] px-3 py-3 text-white" placeholder="Your name" /></label><label class="grid gap-1 text-sm font-semibold text-slate-200">Email<input required type="email" name="email" class="rounded-md border border-[#31506f] bg-[#07111f] px-3 py-3 text-white" placeholder="you@company.com" /></label><label class="grid gap-1 text-sm font-semibold text-slate-200">How can we help?<textarea required name="body" rows="5" class="rounded-md border border-[#31506f] bg-[#07111f] px-3 py-3 text-white" placeholder="Project, infrastructure, or support issue…"></textarea></label><div class="flex flex-wrap gap-3"><button class="btn btn-primary" type="submit">Send Email Request</button><a class="btn btn-secondary" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a></div></div></form></div></section></BaseLayout>
