---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import TechnologyLogo from '../components/TechnologyLogo.astro'; import { technologies } from '../data/site';
const categories=['All','Streaming','IPTV Platforms','Servers','Cloud','DevOps','Monitoring','Security','CDN','Networking'];
---
<BaseLayout title="IPTV & OTT Technologies | Streaming, Cloud & DevOps" description="Platforms and technologies we can deploy, integrate or troubleshoot across streaming, IPTV, servers, cloud, DevOps, monitoring, security and networking."><PageHero eyebrow="Technology Directory" title="Tools across the modern streaming stack." text="Platforms and technologies we can deploy, integrate or troubleshoot. Third-party names are used for identification only and do not imply affiliation or endorsement."/><section class="section"><div class="shell"><div class="flex flex-col gap-4 sm:flex-row"><label class="sr-only" for="tech-search">Search technologies</label><input id="tech-search" class="min-h-12 flex-1 rounded-lg border border-border bg-secondary-bg px-4 text-foreground placeholder:text-muted-dark" placeholder="Search technologies…" type="search"/><div class="flex flex-wrap gap-2" aria-label="Filter technology categories">{categories.map((x,i)=><button class:list={['tech-filter rounded-md border px-3 py-2 text-xs font-bold transition',i===0?'border-primary bg-primary text-ink':'border-border text-muted hover:border-primary']} data-category={x}>{x}</button>)}</div></div><p class="mt-5 text-sm text-muted"><span id="tech-count">{technologies.length}</span> technologies shown</p><div class="mt-5 grid-cards" id="tech-grid">{technologies.map((technology)=><article class="tech-card card p-5" data-name={technology.name.toLowerCase()} data-category={technology.category}><div class="flex items-start justify-between gap-3"><TechnologyLogo logo={technology.logo} logoAlt={technology.logoAlt}/><span class="tag">{technology.category}</span></div><h3>{technology.name}</h3><p>{technology.description}</p></article>)}</div></div></section><script is:inline>{`const input=document.querySelector('#tech-search');const buttons=[...document.querySelectorAll('.tech-filter')];const cards=[...document.querySelectorAll('.tech-card')];const count=document.querySelector('#tech-count');let active='All';function apply(){const term=input.value.toLowerCase().trim();let n=0;cards.forEach(card=>{const show=(active==='All'||card.dataset.category===active)&&card.dataset.name.includes(term);card.hidden=!show;if(show)n++});count.textContent=n}input.addEventListener('input',apply);buttons.forEach(button=>button.addEventListener('click',()=>{active=button.dataset.category;buttons.forEach(b=>b.className='tech-filter rounded-md border border-border px-3 py-2 text-xs font-bold text-muted transition hover:border-primary');button.className='tech-filter rounded-md border border-primary bg-primary px-3 py-2 text-xs font-bold text-ink transition';apply()}));`}</script></BaseLayout>
